@model FuturisticPortfolio.Models.Entities.Experience
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Career Node";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-plus-circle text-neon-purple me-2"></i> Add Career Node</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Cancel</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-panel p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small">COMPANY NAME</label>
                    <input asp-for="Company" class="form-control bg-dark border-secondary text-white" required placeholder="eg. Google" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">ROLE / JOB TITLE</label>
                    <input asp-for="Role" class="form-control bg-dark border-secondary text-white" required placeholder="eg. Senior Software Architect" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">START DATE</label>
                    <input asp-for="StartDate" type="date" class="form-control bg-dark border-secondary text-white" required value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">END DATE (LEAVE EMPTY IF CURRENT)</label>
                    <input asp-for="EndDate" type="date" class="form-control bg-dark border-secondary text-white" />
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsCurrent" class="form-check-input bg-dark border-secondary" />
                    <label class="form-check-label text-muted small" asp-for="IsCurrent">Currently active in this node</label>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">ROLE RESPONSIBILITIES & ACHIEVEMENTS</label>
                    <textarea asp-for="Description" rows="4" class="form-control bg-dark border-secondary text-white" required placeholder="Specify your primary stack usage and engineering achievements..."></textarea>
                </div>

                <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-save me-1"></i> Save Career Node</button>
            </form>
        </div>
    </div>
</div>
