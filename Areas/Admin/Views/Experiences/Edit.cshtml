@model FuturisticPortfolio.Models.Entities.Experience
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Calibrate Career Node";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-edit text-neon-purple me-2"></i> Calibrate Career Node</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Cancel</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-panel p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small">COMPANY NAME</label>
                    <input asp-for="Company" class="form-control bg-dark border-secondary text-white" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">ROLE / JOB TITLE</label>
                    <input asp-for="Role" class="form-control bg-dark border-secondary text-white" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">START DATE</label>
                    <input asp-for="StartDate" type="date" class="form-control bg-dark border-secondary text-white" required value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">END DATE</label>
                    <input asp-for="EndDate" type="date" class="form-control bg-dark border-secondary text-white" value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsCurrent" class="form-check-input bg-dark border-secondary" />
                    <label class="form-check-label text-muted small" asp-for="IsCurrent">Currently active in this node</label>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">ROLE RESPONSIBILITIES & ACHIEVEMENTS</label>
                    <textarea asp-for="Description" rows="4" class="form-control bg-dark border-secondary text-white" required></textarea>
                </div>

                <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-check-circle me-1"></i> Update Career Node</button>
            </form>
        </div>
    </div>
</div>
