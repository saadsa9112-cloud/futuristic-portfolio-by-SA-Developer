@model FuturisticPortfolio.Models.Entities.Skill
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Calibrate Skill Node";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-edit text-neon-purple me-2"></i> Calibrate Skill Node</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Cancel</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-panel p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small">SKILL NAME</label>
                    <input asp-for="Name" class="form-control bg-dark border-secondary text-white" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">PROFICIENCY PERCENTAGE</label>
                    <input asp-for="Percentage" type="number" min="0" max="100" class="form-control bg-dark border-secondary text-white" required />
                    <span asp-validation-for="Percentage" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">FONT AWESOME ICON CLASS</label>
                    <input asp-for="IconClass" class="form-control bg-dark border-secondary text-white" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">NEON GLOW COLOR (HEX CODE)</label>
                    <input asp-for="ColorHex" class="form-control bg-dark border-secondary text-white" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">DISPLAY ORDER INDEX</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control bg-dark border-secondary text-white" />
                </div>

                <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-check-circle me-1"></i> Update Skill Node</button>
            </form>
        </div>
    </div>
</div>
