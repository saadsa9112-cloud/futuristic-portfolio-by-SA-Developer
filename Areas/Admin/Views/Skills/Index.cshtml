@model List<FuturisticPortfolio.Models.Entities.Skill>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Skills";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-sliders-h text-neon-purple me-2"></i> Manage Skills</h1>
    <a asp-action="Create" class="btn btn-neon text-white"><i class="fas fa-plus me-1"></i> Add Skill</a>
</div>

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th>SKILL NAME</th>
                    <th>PERCENTAGE</th>
                    <th>ICON CLASS</th>
                    <th>NEON COLOR</th>
                    <th>ORDER</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No skills loaded in the databank.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold text-white">@item.Name</span></td>
                            <td><code>@item.Percentage%</code></td>
                            <td><i class="@item.IconClass me-2"></i> <code>@item.IconClass</code></td>
                            <td><span class="badge border border-secondary" style="color: @item.ColorHex !important;">@item.ColorHex</span></td>
                            <td>@item.DisplayOrder</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Confirm deletion of this skill?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
