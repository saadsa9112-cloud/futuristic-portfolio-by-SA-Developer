@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ACCESS DENIED - Neo Core</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-dark text-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">

    <!-- Background Ambient Glow -->
    <div class="ambient-glow" style="top:50%; left:50%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(239, 68, 68, 0.15) 0%, rgba(0, 0, 0, 0) 70%);"></div>

    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <!-- Terminal style Access Denied Card -->
                <div class="glass-panel p-5 shadow-lg border border-danger border-opacity-30">
                    <div class="fs-1 text-danger mb-3" style="font-size: 4rem !important;"><i class="fas fa-shield-alt"></i></div>
                    <h1 class="text-white fw-bold">ACCESS DENIED (403)</h1>
                    <p class="text-muted leading-relaxed my-3">
                        Your current authentication key does not contain the required roles to establish a bridge to this admin node.
                    </p>
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="/Admin/Auth/Login" class="btn btn-neon text-white"><i class="fas fa-key me-1"></i> Re-authorize Credentials</a>
                        <a href="/" class="btn btn-outline-secondary rounded-pill px-3">Disconnect & Exit</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
