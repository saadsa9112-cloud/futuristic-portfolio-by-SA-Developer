@model FuturisticPortfolio.Models.Entities.Certificate
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Calibrate Certificate Node";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-edit text-neon-purple me-2"></i> Calibrate Certificate Node</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Cancel</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-panel p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImagePath" />
                <input type="hidden" asp-for="PdfPath" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small">CERTIFICATION NAME</label>
                    <input asp-for="Name" class="form-control bg-dark border-secondary text-white" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">ISSUER ORGANIZATION</label>
                    <input asp-for="Organization" class="form-control bg-dark border-secondary text-white" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">CALIBRATION DATE</label>
                    <input asp-for="Date" type="date" class="form-control bg-dark border-secondary text-white" required value="@Model.Date.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">REPLACE BADGE ILLUSTRATION (OPTIONAL)</label>
                    <div class="mb-2">
                        <img src="@Model.ImagePath" class="rounded border border-secondary" style="height: 45px; object-fit: cover;" />
                        <span class="text-muted small ms-2">Current Badge</span>
                    </div>
                    <input type="file" name="CertImage" class="form-control bg-dark border-secondary text-muted" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">REPLACE CREDENTIAL TRANSCRIPT PDF (OPTIONAL)</label>
                    @if (!string.IsNullOrEmpty(Model.PdfPath))
                    {
                        <div class="mb-2">
                            <span class="badge bg-secondary">Current PDF is active</span>
                        </div>
                    }
                    <input type="file" name="CertPdf" class="form-control bg-dark border-secondary text-muted" />
                </div>

                <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-check-circle me-1"></i> Update Certification Node</button>
            </form>
        </div>
    </div>
</div>
