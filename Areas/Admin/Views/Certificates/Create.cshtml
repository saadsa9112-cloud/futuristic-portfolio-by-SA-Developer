@model FuturisticPortfolio.Models.Entities.Certificate
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Upload Certificate Node";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-plus-circle text-neon-purple me-2"></i> Upload Certificate Node</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Cancel</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-panel p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small">CERTIFICATION NAME</label>
                    <input asp-for="Name" class="form-control bg-dark border-secondary text-white" required placeholder="eg. Microsoft Certified: Azure Solutions Architect" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">ISSUER ORGANIZATION</label>
                    <input asp-for="Organization" class="form-control bg-dark border-secondary text-white" required placeholder="eg. Microsoft / AWS" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">CALIBRATION DATE</label>
                    <input asp-for="Date" type="date" class="form-control bg-dark border-secondary text-white" required value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">BADGE ILLUSTRATION IMAGE (REQUIRED)</label>
                    <input type="file" name="CertImage" class="form-control bg-dark border-secondary text-muted" required />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">CREDENTIAL TRANSCRIPT PDF FILE (OPTIONAL)</label>
                    <input type="file" name="CertPdf" class="form-control bg-dark border-secondary text-muted" />
                </div>

                <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-save me-1"></i> Save Certification Node</button>
            </form>
        </div>
    </div>
</div>
