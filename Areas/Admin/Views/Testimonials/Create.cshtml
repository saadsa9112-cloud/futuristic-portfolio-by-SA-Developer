@model FuturisticPortfolio.Models.Entities.Testimonial
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Client Feedback";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-plus-circle text-neon-purple me-2"></i> Add Client Feedback</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Cancel</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-panel p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small">CLIENT NAME</label>
                    <input asp-for="ClientName" class="form-control bg-dark border-secondary text-white" required placeholder="eg. Elon Musk" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">CLIENT DESIGNATION / COMPANY</label>
                    <input asp-for="ClientTitle" class="form-control bg-dark border-secondary text-white" required placeholder="eg. CEO at SpaceX" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">RATING SCORE (1-5 STARS)</label>
                    <select asp-for="Rating" class="form-select bg-dark border-secondary text-muted">
                        <option value="5" selected>5 Stars</option>
                        <option value="4">4 Stars</option>
                        <option value="3">3 Stars</option>
                        <option value="2">2 Stars</option>
                        <option value="1">1 Star</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">CLIENT PROFILE GRAPHIC (IMAGE FILE)</label>
                    <input type="file" name="ClientPhoto" class="form-control bg-dark border-secondary text-muted" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">FEEDBACK MESSAGE PARAGRAPH</label>
                    <textarea asp-for="Feedback" rows="4" class="form-control bg-dark border-secondary text-white" required placeholder="Write feedback details..."></textarea>
                </div>

                <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-save me-1"></i> Save Testimonial Node</button>
            </form>
        </div>
    </div>
</div>
