@model List<FuturisticPortfolio.Models.Entities.Message>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Comms Inbox";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-inbox text-neon-purple me-2"></i> Inbound Comms Link (Messages)</h1>
    <span class="badge bg-secondary px-3 py-2">INBOX INCOMING</span>
</div>

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th>STATUS</th>
                    <th>TRANSMITTER NAME</th>
                    <th>EMAIL ADDRESS</th>
                    <th>SUBJECT HEADER</th>
                    <th>TRANSMISSION DATE</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">No inbound communication packets logged.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var rowClass = item.IsRead ? "opacity-75" : "fw-bold text-white";
                        <tr>
                            <td>
                                @if (item.IsRead)
                                {
                                    <span class="badge bg-secondary bg-opacity-20 text-muted border border-secondary border-opacity-30">Read</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 animate-pulse">Unread</span>
                                }
                                @if (!string.IsNullOrEmpty(item.ReplyText))
                                {
                                    <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 ms-1">Replied</span>
                                }
                            </td>
                            <td><span class="@rowClass">@item.Name</span></td>
                            <td><code class="text-neon-cyan">@item.Email</code></td>
                            <td><span class="@rowClass">@item.Subject</span></td>
                            <td class="text-muted small">@item.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3">View</a>
                                    
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Confirm deletion of this message log?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
