@using FuturisticPortfolio.Models.Entities
@model List<Visitor>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Visitor Node Auditing Console";
    var searchIp = ViewBag.SearchIp as string;
    var filterCountry = ViewBag.FilterCountry as string;
    var blockedNodes = ViewBag.BlockedNodes as List<FuturisticPortfolio.Services.BlockedNodeEntry> ?? new();
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-network-wired text-neon-cyan me-2"></i> Visitor Node Auditing &amp; Cyber Firewall</h1>
    <span class="badge @(blockedNodes.Any() ? "bg-danger" : "bg-success") px-3 py-2 font-monospace">
        <i class="fas @(blockedNodes.Any() ? "fa-shield-virus" : "fa-shield-alt") me-1"></i>
        @(blockedNodes.Any() ? $"{blockedNodes.Count} THREATS BLOCKED" : "FIREWALL DEFENSES ACTIVE")
    </span>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border border-success bg-dark text-success mb-4 font-monospace small" role="alert" style="border-color: rgba(40, 167, 69, 0.25) !important;">
        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border border-danger bg-dark text-danger mb-4 font-monospace small" role="alert" style="border-color: rgba(220, 53, 69, 0.25) !important;">
        <i class="fas fa-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- CYBER FIREWALL & BLACKLIST MANAGEMENT CONSOLE -->
<div class="glass-panel p-4 mb-4 border border-danger-subtle" style="background: rgba(220, 53, 69, 0.04); border-color: rgba(220, 53, 69, 0.35) !important;">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2 border-bottom border-secondary">
        <div>
            <h5 class="text-white mb-0 font-monospace">
                <i class="fas fa-shield-virus text-danger me-2"></i> Permanent IP Blacklist &amp; Threat Quarantine
            </h5>
            <small class="text-muted font-monospace">Real-time kernel &amp; application layer firewall. Attacks and automated DDoS floods are permanently neutralized here.</small>
        </div>
        <span class="badge @(blockedNodes.Any() ? "bg-danger" : "bg-secondary") px-3 py-2 font-monospace">
            @(blockedNodes.Any() ? $"{blockedNodes.Count} BLOCKED NODE(S)" : "0 QUARANTINED NODES")
        </span>
    </div>

    <!-- Quick Manual Blacklist Form -->
    <form asp-action="BlockIp" method="post" class="row g-2 align-items-center mb-4 p-3 rounded bg-dark border border-secondary">
        @Html.AntiForgeryToken()
        <div class="col-md-4">
            <label class="small text-muted font-monospace mb-1">MANUAL NODE QUARANTINE (IP)</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-secondary border-secondary text-neon-cyan"><i class="fas fa-network-wired"></i></span>
                <input type="text" name="ip" required class="form-control bg-dark border-secondary text-white font-monospace" placeholder="e.g. 192.168.1.50 or 203.0.113.19" />
            </div>
        </div>
        <div class="col-md-5">
            <label class="small text-muted font-monospace mb-1">REASON / THREAT CLASSIFICATION</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-secondary border-secondary text-warning"><i class="fas fa-exclamation-triangle"></i></span>
                <input type="text" name="reason" class="form-control bg-dark border-secondary text-white" placeholder="e.g. DDoS Flood Attack, Malicious Probe, Manual Quarantine..." value="Manual Admin Blacklist" />
            </div>
        </div>
        <div class="col-md-3 d-grid pt-md-3">
            <button type="submit" class="btn btn-sm btn-danger font-monospace">
                <i class="fas fa-ban me-1"></i> Blacklist Node
            </button>
        </div>
    </form>

    <!-- Blacklisted Nodes Table -->
    <h6 class="text-white font-monospace mb-2 small text-uppercase tracking-wider">
        <i class="fas fa-list-ul text-neon-purple me-1"></i> Active Blacklist Registry
    </h6>
    @if (!blockedNodes.Any())
    {
        <div class="p-3 rounded bg-dark border border-secondary text-center text-muted small font-monospace">
            <i class="fas fa-check-shield text-success me-1"></i> No IP addresses are currently blacklisted. Zero active quarantined threats.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-sm table-hover align-middle mb-0 border border-secondary">
                <thead>
                    <tr class="text-muted small font-monospace">
                        <th>BLOCKED IP ADDRESS</th>
                        <th>THREAT CLASSIFICATION / REASON</th>
                        <th>QUARANTINE TIMESTAMP</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody class="small font-monospace">
                    @foreach (var node in blockedNodes)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-danger text-white px-2 py-1">
                                    <i class="fas fa-lock me-1"></i> @node.Ip
                                </span>
                            </td>
                            <td>
                                <span class="text-warning">@node.Reason</span>
                            </td>
                            <td class="text-muted">
                                @node.BlockedAt.ToString("dd MMM yyyy HH:mm:ss") UTC
                            </td>
                            <td>
                                <form asp-action="UnblockIp" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ip" value="@node.Ip" />
                                    <button type="submit" class="btn btn-sm btn-outline-success px-3 py-0.5 rounded font-monospace" onclick="return confirm('Restore access for node @node.Ip?');">
                                        <i class="fas fa-unlock me-1"></i> Unblock Node
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="glass-panel p-4 mb-4">
    <h5 class="text-white mb-3 font-monospace"><i class="fas fa-filter text-neon-purple me-1"></i> Filter Visitor Diagnostics</h5>
    <form method="get" class="row g-3">
        <div class="col-md-5">
            <input type="text" name="searchIp" value="@searchIp" class="form-control bg-dark border-secondary text-white font-monospace" placeholder="Query IP Address..." />
        </div>
        <div class="col-md-5">
            <input type="text" name="filterCountry" value="@filterCountry" class="form-control bg-dark border-secondary text-white" placeholder="Filter by Country..." />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-neon text-white"><i class="fas fa-search me-1"></i> Scan</button>
        </div>
    </form>
</div>

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th>VISIT DATE</th>
                    <th>IP ADDRESS</th>
                    <th>COUNTRY</th>
                    <th>TARGET NODE</th>
                    <th>DEVICE PLATFORM</th>
                    <th>BROWSER</th>
                    <th>TIME SPENT</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No visitor nodes matched the audit filters.</td>
                    </tr>
                }
                else
                {
                    foreach (var v in Model)
                    {
                        <tr>
                            <td class="text-muted">@v.VisitDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                <span class="badge bg-secondary font-monospace text-neon-cyan px-2">@v.IpAddress</span>
                                @if ((ViewBag.BlockedIps as List<string>)?.Contains(v.IpAddress) == true)
                                {
                                    <span class="badge bg-danger font-monospace px-1.5 ms-1"><i class="fas fa-ban me-1"></i>BLOCKED</span>
                                }
                            </td>
                            <td>
                                <i class="fas fa-map-marker-alt text-neon-purple me-1"></i>
                                <span>@(v.Country ?? "Local Loopback")</span>
                            </td>
                            <td><code class="text-white">@v.PagePath</code></td>
                            <td>
                                <i class="fab @GetDeviceIcon(v.UserAgent) me-1"></i>
                                <span>@GetDeviceName(v.UserAgent)</span>
                            </td>
                            <td>
                                <i class="fas fa-globe text-neon-blue me-1"></i>
                                <span>@GetBrowserName(v.UserAgent)</span>
                            </td>
                            <td>
                                @if (v.TimeSpentSeconds > 0)
                                {
                                    <span class="text-success fw-semibold"><i class="fas fa-clock me-1 text-success"></i> @(v.TimeSpentSeconds)s</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Just Landed</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="/Admin/Visitors/Details/@v.Id" class="btn btn-sm btn-neon btn-neon-cyan text-white px-3"><i class="fas fa-eye me-1"></i> Audit Logs</a>
                                    
                                    @if ((ViewBag.BlockedIps as List<string>)?.Contains(v.IpAddress) == true)
                                    {
                                        <form asp-action="UnblockIp" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ip" value="@v.IpAddress" />
                                            <button type="submit" class="btn btn-sm btn-outline-success px-3 rounded"><i class="fas fa-unlock me-1"></i> Unblock</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="BlockIp" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ip" value="@v.IpAddress" />
                                            <input type="hidden" name="reason" value="Manual Admin Quarantine from Visitor Log" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3 rounded" onclick="return confirm('Are you sure you want to blacklist this node? They will be immediately blocked from accessing the site.');"><i class="fas fa-ban me-1"></i> Block</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    public string GetDeviceIcon(string? userAgent)
    {
        if (string.IsNullOrEmpty(userAgent)) return "fa-laptop";
        userAgent = userAgent.ToLower();
        if (userAgent.Contains("iphone") || userAgent.Contains("ipad")) return "fa-apple text-neon-cyan";
        if (userAgent.Contains("android")) return "fa-android text-success";
        if (userAgent.Contains("windows")) return "fa-windows text-primary";
        if (userAgent.Contains("macintosh")) return "fa-apple text-light";
        if (userAgent.Contains("linux")) return "fa-linux text-warning";
        return "fa-laptop text-muted";
    }

    public string GetDeviceName(string? userAgent)
    {
        if (string.IsNullOrEmpty(userAgent)) return "Generic Client";
        if (userAgent.Contains("iPhone")) return "iPhone (iOS)";
        if (userAgent.Contains("iPad")) return "iPad (iOS)";
        if (userAgent.Contains("Android")) return "Android Device";
        if (userAgent.Contains("Windows")) return "Windows PC";
        if (userAgent.Contains("Macintosh")) return "MacBook / iMac";
        if (userAgent.Contains("Linux")) return "Linux Client";
        return "Desktop Node";
    }

    public string GetBrowserName(string? userAgent)
    {
        if (string.IsNullOrEmpty(userAgent)) return "Browser";
        if (userAgent.Contains("Edg")) return "Edge";
        if (userAgent.Contains("Chrome") && !userAgent.Contains("Edg")) return "Chrome";
        if (userAgent.Contains("Safari") && !userAgent.Contains("Chrome")) return "Safari";
        if (userAgent.Contains("Firefox")) return "Firefox";
        return "Web Browser";
    }
}
