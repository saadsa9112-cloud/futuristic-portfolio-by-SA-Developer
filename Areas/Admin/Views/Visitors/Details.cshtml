@using FuturisticPortfolio.Models.Entities
@model Visitor
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Visitor Activity Telemetry Logs";
    var logs = ViewBag.Logs as List<ActivityLog>;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-terminal text-neon-purple me-2"></i> Visitor Auditing Logs</h1>
    <a href="/Admin/Visitors" class="btn btn-outline-light rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Back to Console</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border border-success bg-dark text-success mb-4 font-monospace small" role="alert" style="border-color: rgba(40, 167, 69, 0.25) !important;">
        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="row g-4">
    <!-- Visitor Profile Panel -->
    <div class="col-lg-4">
        <div class="glass-panel p-4 h-100">
            <h4 class="h5 text-white fw-bold mb-3 border-bottom border-secondary pb-2"><i class="fas fa-id-card text-neon-cyan me-1"></i> Terminal Profile</h4>
            <table class="table table-dark table-borderless table-sm small align-middle">
                <tbody>
                    <tr>
                        <td class="text-muted" style="width: 110px;">NODE ID:</td>
                        <td class="text-white font-monospace">#@Model.Id</td>
                    </tr>
                    <tr>
                        <td class="text-muted">IP ADDRESS:</td>
                        <td><span class="badge bg-secondary text-neon-cyan font-monospace">@Model.IpAddress</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">COUNTRY:</td>
                        <td><i class="fas fa-map-marker-alt text-neon-purple me-1"></i> @(Model.Country ?? "Local IP")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">LANDING NODE:</td>
                        <td><code class="text-white">@Model.PagePath</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">TOTAL TIME:</td>
                        <td><span class="text-success fw-bold"><i class="fas fa-clock text-success me-1"></i> @(Model.TimeSpentSeconds)s</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">DATE TIME:</td>
                        <td class="text-muted">@Model.VisitDate.ToString("dd MMM yyyy HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">DEVICE OS:</td>
                        <td>@GetDeviceName(Model.UserAgent)</td>
                    </tr>
                    <tr>
                        <td class="text-muted">BROWSER:</td>
                        <td>@GetBrowserName(Model.UserAgent)</td>
                    </tr>
                </tbody>
            </table>
            
            <div class="mt-4 pt-3 border-top border-secondary">
                <span class="small text-muted font-monospace d-block mb-1">RAW SIGNATURE:</span>
                <div class="p-2 rounded bg-black font-monospace text-muted small text-break" style="font-size: 11px; line-height: 1.4; background: rgba(0,0,0,0.3);">
                    @Model.UserAgent
                </div>
            </div>

            <div class="mt-3 pt-3 border-top border-secondary text-center">
                @if (ViewBag.IsBlocked == true)
                {
                    <form asp-action="UnblockIp" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ip" value="@Model.IpAddress" />
                        <input type="hidden" name="returnUrl" value="/Admin/Visitors/Details/@Model.Id" />
                        <button type="submit" class="btn btn-success w-100"><i class="fas fa-unlock me-1"></i> Unblock Node Address</button>
                    </form>
                }
                else
                {
                    <form asp-action="BlockIp" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ip" value="@Model.IpAddress" />
                        <input type="hidden" name="returnUrl" value="/Admin/Visitors/Details/@Model.Id" />
                        <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Are you sure you want to black-list this visitor? They will be immediately blocked from accessing the site.');"><i class="fas fa-ban me-1"></i> Blacklist Node Address</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Visitor Activity Timeline -->
    <div class="col-lg-8">
        <div class="glass-panel p-4 h-100">
            <h4 class="h5 text-white fw-bold mb-4"><i class="fas fa-route text-success me-1"></i> Telemetry Handshake Trail (Activity Timeline)</h4>
            
            @if (logs == null || !logs.Any())
            {
                <div class="text-center py-5 text-muted small">
                    <i class="fas fa-search text-muted d-block fs-3 mb-3" style="animation: pulse 1s infinite alternate;"></i>
                    No detailed click interactions (gallery opens, video play clicks, right clicks, CV downloads) have been logged from this IP.
                </div>
            }
            else
            {
                <div class="timeline-container px-3">
                    <div class="timeline" style="border-left: 2px solid rgba(168, 85, 247, 0.25); padding-left: 20px; position: relative;">
                        @foreach (var log in logs)
                        {
                            var icon = "fa-mouse-pointer text-neon-cyan";
                            var cardBorder = "border-secondary";
                            
                            if (log.Action != null && log.Action.Contains("Intrusion"))
                            {
                                icon = "fa-shield-alt text-danger";
                                cardBorder = "border-danger";
                            }
                            else if (log.Action != null && log.Action.Contains("Bypass"))
                            {
                                icon = "fa-exclamation-triangle text-warning";
                                cardBorder = "border-warning";
                            }
                            else if (log.Details != null && log.Details.Contains("CV"))
                            {
                                icon = "fa-file-download text-success";
                                cardBorder = "border-success";
                            }
                            else if (log.Details != null && log.Details.Contains("Video"))
                            {
                                icon = "fa-video text-neon-blue";
                                cardBorder = "border-info";
                            }
                            else if (log.Details != null && log.Details.Contains("Save Image"))
                            {
                                icon = "fa-copy text-warning";
                                cardBorder = "border-warning";
                            }

                            <div class="mb-4 position-relative">
                                <!-- Marker dot -->
                                <div class="position-absolute rounded-circle bg-dark border border-secondary d-flex align-items-center justify-content-center" 
                                     style="left: -32px; top: 2px; width: 22px; height: 22px; z-index: 2;">
                                    <i class="fas @icon" style="font-size: 10px;"></i>
                                </div>
                                
                                <div class="p-3 rounded border bg-dark glass-panel @cardBorder">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-dark border border-secondary text-white text-uppercase" style="font-size: 10px;">@log.Action</span>
                                        <span class="small text-muted font-monospace">@log.Timestamp.ToString("HH:mm:ss")</span>
                                    </div>
                                    <p class="mb-0 text-light small font-monospace">@log.Details</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    public string GetDeviceName(string? userAgent)
    {
        if (string.IsNullOrEmpty(userAgent)) return "Generic Client";
        if (userAgent.Contains("iPhone")) return "iPhone (iOS)";
        if (userAgent.Contains("iPad")) return "iPad (iOS)";
        if (userAgent.Contains("Android")) return "Android Device";
        if (userAgent.Contains("Windows")) return "Windows PC";
        if (userAgent.Contains("Macintosh")) return "MacBook / iMac";
        if (userAgent.Contains("Linux")) return "Linux Client";
        return "Desktop Node";
    }

    public string GetBrowserName(string? userAgent)
    {
        if (string.IsNullOrEmpty(userAgent)) return "Browser";
        if (userAgent.Contains("Edg")) return "Edge";
        if (userAgent.Contains("Chrome") && !userAgent.Contains("Edg")) return "Chrome";
        if (userAgent.Contains("Safari") && !userAgent.Contains("Chrome")) return "Safari";
        if (userAgent.Contains("Firefox")) return "Firefox";
        return "Web Browser";
    }
}
