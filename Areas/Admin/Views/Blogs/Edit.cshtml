@model FuturisticPortfolio.Models.Entities.Blog
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Calibrate Tech Log Node";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-edit text-neon-purple me-2"></i> Configure Tech Log</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Cancel</a>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="blog-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImagePath" />
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="row g-4">
        <!-- Main Edit Form Column -->
        <div class="col-lg-8">
            <div class="glass-panel p-4 mb-4">
                <h3 class="h5 text-white fw-bold mb-4">// Article Body Content</h3>

                <div class="mb-3">
                    <label class="form-label text-muted small">ARTICLE TITLE</label>
                    <input asp-for="Title" class="form-control bg-dark border-secondary text-white" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">URL SLUG</label>
                    <input asp-for="Slug" class="form-control bg-dark border-secondary text-white" />
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">RICH TEXT ARTICLE CONTENT</label>
                    <div id="editor-container" style="height: 380px;" class="bg-dark text-white border-secondary"></div>
                    <input type="hidden" asp-for="Content" id="hidden-content-input" required />
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>
            </div>

            <!-- SEO Specifications -->
            <div class="glass-panel p-4 mb-4">
                <h3 class="h5 text-white fw-bold mb-4">// SEO Calibration & Tags</h3>
                
                <div class="mb-3">
                    <label class="form-label text-muted small">META TITLE (SEO)</label>
                    <input asp-for="MetaTitle" class="form-control bg-dark border-secondary text-white" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">META DESCRIPTION (SEO)</label>
                    <textarea asp-for="MetaDescription" rows="3" class="form-control bg-dark border-secondary text-white"></textarea>
                </div>
            </div>
        </div>

        <!-- Sidebar Parameter Edit Column -->
        <div class="col-lg-4">
            <div class="glass-panel p-4 mb-4">
                <h3 class="h5 text-white fw-bold mb-4">// Calibration Specs</h3>

                <div class="mb-3">
                    <label class="form-label text-muted small">ARTICLE CATEGORY</label>
                    <select asp-for="CategoryId" class="form-select bg-dark border-secondary text-muted" asp-items="ViewBag.CategoryId">
                        <option value="">Choose Category</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">TAGS (COMMA SEPARATED)</label>
                    <input asp-for="Tags" class="form-control bg-dark border-secondary text-white" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">REPLACE COVER LOG IMAGE (OPTIONAL)</label>
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImagePath" class="rounded border border-secondary" style="height: 45px; object-fit: cover;" />
                            <span class="text-muted small ms-2">Current Cover</span>
                        </div>
                    }
                    <input type="file" name="CoverImage" class="form-control bg-dark border-secondary text-muted" />
                </div>
            </div>

            <div class="mb-4">
                <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-check-circle me-1"></i> Update Article Node</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Quill Rich text editor initialization
            const quill = new Quill('#editor-container', {
                theme: 'snow',
                placeholder: 'Write article content details here...',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        ['blockquote', 'code-block'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['link', 'clean']
                    ]
                }
            });

            // Set Initial content
            quill.root.innerHTML = `@Html.Raw(Model.Content)`;

            // Sync hidden content field on submit
            const form = document.getElementById("blog-form");
            form.addEventListener("submit", (e) => {
                const hiddenInput = document.getElementById("hidden-content-input");
                hiddenInput.value = quill.root.innerHTML;
            });
        });
    </script>
}
