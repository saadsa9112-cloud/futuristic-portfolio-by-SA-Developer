@model FuturisticPortfolio.Models.Entities.Education
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Academic Node";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom border-secondary">
    <h1 class="h2 text-white fw-bold"><i class="fas fa-plus-circle text-neon-purple me-2"></i> Add Academic Node</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Cancel</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-panel p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small">INSTITUTION NAME</label>
                    <input asp-for="Institution" class="form-control bg-dark border-secondary text-white" required placeholder="eg. Massachusetts Institute of Technology" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">DEGREE / CERTIFICATION TITLE</label>
                    <input asp-for="Degree" class="form-control bg-dark border-secondary text-white" required placeholder="eg. Bachelor of Science in Computer Science" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">START DATE</label>
                    <input asp-for="StartDate" type="date" class="form-control bg-dark border-secondary text-white" required value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">END DATE (LEAVE EMPTY IF PRESENT)</label>
                    <input asp-for="EndDate" type="date" class="form-control bg-dark border-secondary text-white" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">DESCRIPTION / DETAILS (OPTIONAL)</label>
                    <textarea asp-for="Description" rows="4" class="form-control bg-dark border-secondary text-white" placeholder="Major coursework, CGPA achievements..."></textarea>
                </div>

                <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-save me-1"></i> Save Academic Node</button>
            </form>
        </div>
    </div>
</div>
