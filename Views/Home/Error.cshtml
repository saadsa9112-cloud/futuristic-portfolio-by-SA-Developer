@{
    ViewData["Title"] = "System Error";
}

<div class="container py-5 text-center" style="min-height: 70vh; display: flex; align-items: center; justify-content: center; flex-direction: column;" data-aos="zoom-in">
    <div class="fs-1 text-danger mb-4" style="font-size: 5rem !important;"><i class="fas fa-exclamation-triangle"></i></div>
    <h1 class="display-4 text-white fw-bold">CRITICAL SIGNAL ERROR (500)</h1>
    <p class="lead text-muted max-w-md mx-auto">
        Comms link corrupted. The internal system encountered an unhandled execution pipeline exception.
    </p>
    <a href="/" class="btn btn-neon mt-4 text-white">Reconnect & Reset Terminal</a>
</div>
