@using FuturisticPortfolio.Models.Entities
@{
    ViewData["Title"] = "Home";
    var settings = ViewBag.Settings as Settings;
    var skills = ViewBag.Skills as List<Skill>;
    var statistics = ViewBag.Statistics as List<Statistic>;
    var featuredProject = ViewBag.FeaturedProject as Project;
    var latestProjects = ViewBag.LatestProjects as List<Project>;
}

<!-- HERO SECTION -->
<section class="d-flex align-items-center position-relative overflow-hidden" style="min-height: calc(100vh - var(--header-total-height) - 40px);">
    <div class="container py-5 z-2">
        <div class="row align-items-center">
            <div class="col-lg-6 text-center text-lg-start" data-aos="fade-right">
                <div class="dev-status-pill">
                    <span class="status-pulse-dot"></span>
                    SOFTWARE DEVELOPER // .NET 10 &amp; MERN STACK
                </div>
                <h1 class="display-3 fw-bold text-white mb-1 text-lg-nowrap">
                    Hi, I am <span class="text-neon-purple">HMS Developer</span>
                </h1>
                <div class="h5 text-white opacity-75 font-monospace mb-3">Hafiz Muhammad Saad</div>
                <h2 class="h2 fw-semibold mb-4 text-neon-cyan font-monospace">
                    <span id="typed-subtitle"></span>
                </h2>
                <p class="lead text-muted mb-4 max-w-lg">
                    Architecting high-concurrency ASP.NET Core &amp; MERN Stack web solutions, creative UI/UX Graphic Designs, and high-conversion SEO performance architectures.
                </p>
                <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                    <a href="~/files/Muhammad_Saad_CV.pdf" download="Muhammad_Saad_CV.pdf" class="btn btn-neon text-white font-monospace cv-download-trigger"><i class="fas fa-file-code me-2"></i> Download CV</a>
                    <a asp-controller="Portfolio" asp-action="Index" class="btn btn-neon btn-neon-cyan text-white font-monospace"><i class="fas fa-terminal me-2"></i> View Projects</a>
                    <a href="#contact-section" class="btn btn-outline-light border-secondary px-4 rounded-pill hover-text-white font-monospace"><i class="fas fa-paper-plane me-2"></i> Contact Me</a>
                </div>

                <!-- Diagnostic Badge -->
                <div class="system-diagnostic-badge mt-4 p-2 rounded border border-secondary bg-dark font-monospace text-muted d-inline-block text-start" id="system-diagnostic" style="font-size: 0.75rem; border-color: rgba(0, 240, 255, 0.2) !important; background: rgba(13, 10, 26, 0.6) !important;">
                    <i class="fas fa-microchip text-neon-cyan me-1"></i> [SYS STATUS: Online | ASP.NET Core 10 &amp; SQL Server Active | 0 Warnings]
                </div>
            </div>

            <!-- Developer IDE Window + Profile HUD -->
            <div class="col-lg-6 mt-5 mt-lg-0" data-aos="zoom-in" data-aos-delay="200">
                <div class="dev-ide-window shadow-lg">
                    <div class="dev-ide-topbar">
                        <div class="dev-ide-dots">
                            <span></span><span></span><span></span>
                        </div>
                        <div class="dev-ide-tab"><i class="fas fa-file-code text-neon-cyan"></i> SoftwareEngineer.cs</div>
                        <span class="badge bg-dark border border-secondary text-muted font-monospace" style="font-size: 0.65rem;">C# 13 / .NET 10</span>
                    </div>
                    <div class="dev-ide-body">
                        <div><span class="code-keyword">namespace</span> <span class="code-type">Saad.Enterprise</span>;</div>
                        <br/>
                        <div><span class="code-keyword">public sealed class</span> <span class="code-type">SoftwareEngineer</span> : <span class="code-type">IDeveloper</span></div>
                        <div>{</div>
                        <div class="ps-3"><span class="code-keyword">public string</span> <span class="code-var">Name</span> =&gt; <span class="code-string">"Hafiz Muhammad Saad"</span>;</div>
                        <div class="ps-3"><span class="code-keyword">public string[]</span> <span class="code-var">CoreStack</span> =&gt; [ <span class="code-string">"ASP.NET Core 10"</span>, <span class="code-string">"C#"</span>, <span class="code-string">"SQL Server"</span>, <span class="code-string">"React 19"</span> ];</div>
                        <div class="ps-3"><span class="code-keyword">public string</span> <span class="code-var">Degree</span> =&gt; <span class="code-string">"BSBC - Sohail University"</span>;</div>
                        <div class="ps-3"><span class="code-keyword">public string</span> <span class="code-var">Status</span> =&gt; <span class="code-string">"Ready for Enterprise Delivery"</span>;</div>
                        <br/>
                        <div class="ps-3"><span class="code-comment">// Verified Production Solutions</span></div>
                        <div class="ps-3"><span class="code-keyword">public async Task</span> <span class="code-method">DeploySolutionsAsync</span>()</div>
                        <div class="ps-3">{</div>
                        <div class="ps-4"><span class="code-keyword">await</span> <span class="code-type">NedAcademy</span>.<span class="code-method">ManageAcademicSystemAsync</span>();</div>
                        <div class="ps-4"><span class="code-keyword">await</span> <span class="code-type">NexoraDigital</span>.<span class="code-method">LaunchPlatformAsync</span>();</div>
                        <div class="ps-3">}</div>
                        <div>}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- QUICK STATS STRIP (IDE TELEMETRY METRICS) -->
@if (statistics != null && statistics.Any())
{
    <section class="py-5 border-y border-secondary border-opacity-20 bg-dark bg-opacity-40" id="stats-section">
        <div class="container">
            <div class="row g-4 text-center justify-content-center">
                @foreach (var stat in statistics)
                {
                    var isPlusSuffix = stat.Title.Contains("Project", StringComparison.OrdinalIgnoreCase) ||
                                       stat.Title.Contains("Experience", StringComparison.OrdinalIgnoreCase) ||
                                       stat.Title.Contains("Coding", StringComparison.OrdinalIgnoreCase) ||
                                       stat.Title.Contains("Year", StringComparison.OrdinalIgnoreCase);
                    <div class="col-6 col-md-3">
                        <div class="stat-dev-card">
                            <span class="stat-metric-id">METRIC // @(stat.DisplayOrder.ToString("D2"))</span>
                            <h3 class="text-neon-purple fw-bold display-5 mb-0 d-inline-flex align-items-center justify-content-center">
                                <span class="counter-number" data-target="@stat.Value">0</span>@if (isPlusSuffix) {<span class="counter-suffix">+</span>}
                            </h3>
                            <span class="text-muted small d-block mt-2 font-monospace">@stat.Title</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ABOUT TEASER SECTION -->
<section class="py-5">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="badge bg-dark border border-secondary text-neon-purple font-monospace mb-2">ABOUT THE DEVELOPER</span>
                <h2 class="display-5 text-white fw-bold mb-3">Software Engineering &amp; Business Computing</h2>
                <p class="text-muted leading-relaxed mb-4">
                    Pursuing <strong>BSBC</strong> at Sohail University and <strong>Advanced Diploma in Software Engineering (ADSE)</strong> at Aptech Learning. Passionate about clean code architecture, relational databases, C#, ASP.NET Core MVC, and modern web application development.
                </p>
                
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge bg-dark border border-info font-monospace p-2" style="color: #00D9FF !important; border-color: rgba(0, 217, 255, 0.5) !important; box-shadow: 0 0 10px rgba(0, 217, 255, 0.2);"><i class="fas fa-graduation-cap me-1"></i> Sohail University (BSBC) — CURRENT DEGREE</span>
                    <span class="badge bg-dark border border-secondary font-monospace p-2" style="color: #A855F7 !important; border-color: rgba(168, 85, 247, 0.4) !important; box-shadow: 0 0 10px rgba(168, 85, 247, 0.2);"><i class="fas fa-university me-1"></i> Aptech Learning (ADSE) — PROFESSIONAL DIPLOMA</span>
                </div>

                <a asp-controller="Home" asp-action="About" class="btn btn-neon text-white font-monospace"><i class="fas fa-user-circle me-2"></i> Read Full Story</a>
            </div>

            <div class="col-lg-6 mt-4 mt-lg-0" data-aos="fade-left">
                <div class="glass-panel p-4 p-md-5 border-0">
                    <h4 class="text-white fw-bold mb-3 font-monospace"><i class="fas fa-layer-group text-neon-cyan me-2"></i> Core Specializations</h4>
                    <ul class="list-unstyled text-muted small d-flex flex-column gap-3 mb-0">
                        <li class="d-flex align-items-center gap-3">
                            <i class="fas fa-check-circle text-neon-purple fs-5"></i>
                            <div>
                                <strong class="text-white d-block">ASP.NET Core MVC Architecture</strong>
                                Clean Controllers, ViewModels, Dependency Injection, and Razor layouts.
                            </div>
                        </li>
                        <li class="d-flex align-items-center gap-3">
                            <i class="fas fa-check-circle text-neon-cyan fs-5"></i>
                            <div>
                                <strong class="text-white d-block">SQL Server Database Normalization</strong>
                                Entity Framework Core migrations, LINQ optimization, and relational schemas.
                            </div>
                        </li>
                        <li class="d-flex align-items-center gap-3">
                            <i class="fas fa-check-circle text-neon-blue fs-5"></i>
                            <div>
                                <strong class="text-white d-block">Modern Responsive Web Systems</strong>
                                Clean UI design system, glassmorphism, and dual Light/Dark mode themes.
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ZERO-TRUST CYBERSECURITY & ARCHITECTURAL AUDIT ENGINE -->
<section class="py-5 position-relative overflow-hidden" id="cyber-audit-section">
    <div class="container py-4" data-aos="fade-up">
        <div class="glass-panel p-4 p-md-5 cyber-hud-card" style="border: 1px solid rgba(0, 240, 255, 0.3) !important;">
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="pulse-dot-green"></span>
                        <span class="badge bg-dark border border-info text-neon-cyan font-monospace">CYBERSECURITY SEC-OPS AUDIT</span>
                    </div>
                    <h2 class="display-6 text-white fw-bold mb-3">Zero-Trust Security &amp; Architecture Audit</h2>
                    <p class="text-muted leading-relaxed mb-4">
                        Perform an instant, real-time cryptographic audit on portfolio endpoints, runtime memory invariant checks, EF Core SQL injection immunity, and Claude Mythos prompt defense layers.
                    </p>
                    
                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <button type="button" class="btn btn-neon btn-neon-cyan text-white font-monospace px-4 py-2" id="run-audit-btn">
                            <i class="fas fa-shield-virus me-2"></i> Run Live Security Audit
                        </button>
                        <button type="button" class="btn btn-outline-light border-secondary text-white font-monospace px-3 py-2" id="clear-audit-btn">
                            <i class="fas fa-redo-alt me-1"></i> Reset
                        </button>
                    </div>

                    <!-- Telemetry Metrics Grid -->
                    <div class="row g-2 font-monospace" style="font-size: 0.8rem;">
                        <div class="col-6">
                            <div class="p-2.5 rounded bg-dark border border-secondary border-opacity-30">
                                <span class="text-muted d-block mb-1">CIPHER SUITE</span>
                                <span class="text-neon-cyan fw-bold"><i class="fas fa-lock me-1 text-success"></i> TLS 1.3 / AES-256</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2.5 rounded bg-dark border border-secondary border-opacity-30">
                                <span class="text-muted d-block mb-1">INJECTION SHIELD</span>
                                <span class="text-neon-purple fw-bold"><i class="fas fa-shield-alt me-1 text-neon-purple"></i> EF Core Parameterized</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2.5 rounded bg-dark border border-secondary border-opacity-30">
                                <span class="text-muted d-block mb-1">KERNEL PROBES</span>
                                <span class="text-neon-green fw-bold"><i class="fas fa-microchip me-1 text-neon-green"></i> eBPF RingBuffer Active</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2.5 rounded bg-dark border border-secondary border-opacity-30">
                                <span class="text-muted d-block mb-1">AI GUARDRAIL</span>
                                <span class="text-warning fw-bold"><i class="fas fa-brain me-1 text-warning"></i> Claude Mythos Strict</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Live Terminal Scan Screen -->
                <div class="col-lg-6">
                    <div class="cyber-terminal-card shadow-lg p-0 overflow-hidden" style="background: #06030f; border: 1px solid rgba(0, 240, 255, 0.4); border-radius: 12px;">
                        <div class="project-window-bar d-flex align-items-center justify-content-between px-3 py-2" style="background: rgba(18, 11, 35, 0.95); border-bottom: 1px solid rgba(0, 240, 255, 0.2);">
                            <div class="d-flex align-items-center gap-2">
                                <span class="p-dot red"></span>
                                <span class="p-dot yellow"></span>
                                <span class="p-dot green"></span>
                                <span class="project-window-title text-muted font-monospace small">secops@audit-daemon ~ bash</span>
                            </div>
                            <span class="badge bg-dark border border-success text-neon-green font-monospace" style="font-size: 0.65rem;" id="audit-status-pill">READY TO SCAN</span>
                        </div>
                        <div class="p-3 font-monospace" id="audit-terminal-screen" style="height: 250px; overflow-y: auto; font-size: 0.8rem; line-height: 1.6; color: #a5f3fc; background: #070414;">
                            <div class="text-muted">// Zero-Trust Continuous Security Telemetry Daemon</div>
                            <div class="text-muted">// Click "Run Live Security Audit" above to test active defensive layers...</div>
                            <div class="mt-2 text-neon-purple">&gt; All security sensors idling at 0.0% CPU overhead.</div>
                        </div>
                        <div class="p-2.5 bg-dark border-top border-secondary border-opacity-30 d-flex justify-content-between align-items-center font-monospace" style="font-size: 0.75rem;">
                            <span class="text-muted">OVERALL COMPLIANCE SCORE:</span>
                            <span class="text-neon-green fw-bold" id="audit-score-val">A+ [100% SECURE]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURED & LATEST PROJECTS SECTION (TERMINAL WINDOW CARDS) -->
@if (featuredProject != null || (latestProjects != null && latestProjects.Any()))
{
    <section class="py-5 bg-dark bg-opacity-40">
        <div class="container py-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end mb-4" data-aos="fade-up">
                <div>
                    <span class="badge bg-dark border border-secondary text-neon-cyan font-monospace mb-2">SYSTEM CATALOG (5 SYSTEMS)</span>
                    <h2 class="display-5 text-white fw-bold mb-0">Production Systems &amp; Lab Prototypes</h2>
                </div>
                <a asp-controller="Portfolio" asp-action="Index" class="btn btn-outline-light border-secondary rounded-pill hover-text-white mt-3 mt-md-0 font-monospace"><i class="fas fa-th-large me-2"></i> Explore All Projects</a>
            </div>
            
            <div class="row g-4 justify-content-center">
                @if (featuredProject != null)
                {
                    var isFeaturedUnderDev = featuredProject.Description?.Contains("UNDER DEVELOPMENT", StringComparison.OrdinalIgnoreCase) == true ||
                                             featuredProject.Title?.Contains("CyberSentinel", StringComparison.OrdinalIgnoreCase) == true ||
                                             featuredProject.Title?.Contains("NeuralMesh", StringComparison.OrdinalIgnoreCase) == true;
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="card project-terminal-card h-100 cyber-hud-card @(isFeaturedUnderDev ? "under-dev-card" : "")">
                            <div class="project-window-bar">
                                <span class="p-dot red"></span>
                                <span class="p-dot yellow"></span>
                                <span class="p-dot green"></span>
                                <span class="project-window-title">~/projects/@(featuredProject.Title.ToLower().Replace(" ", "-").Replace("(", "").Replace(")", ""))</span>
                                @if (isFeaturedUnderDev)
                                {
                                    <span class="project-window-badge" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; border: 1px solid #f59e0b;"><i class="fas fa-tools me-1"></i> UNDER DEV</span>
                                }
                                else
                                {
                                    <span class="project-window-badge">FEATURED</span>
                                }
                            </div>

                            @if (isFeaturedUnderDev)
                            {
                                <!-- State A: Sleek Normal View -->
                                <div class="under-dev-normal-view d-flex flex-column flex-grow-1">
                                    <div class="position-relative overflow-hidden" style="height: 230px;">
                                        <img src="@featuredProject.ThumbnailPath" alt="@featuredProject.Title" class="project-thumb-img" />
                                        <div class="position-absolute top-0 end-0 m-3">
                                            @if (featuredProject.Category != null)
                                            {
                                                <span class="badge bg-dark bg-opacity-80 border border-secondary text-neon-cyan font-monospace">@featuredProject.Category.Name</span>
                                            }
                                        </div>
                                        <div class="position-absolute bottom-0 start-0 end-0 p-2 text-center font-monospace small" style="background: rgba(10, 8, 20, 0.85); backdrop-filter: blur(8px); border-top: 1px solid rgba(245, 158, 11, 0.4); color: #f59e0b; font-weight: 600;">
                                            <i class="fas fa-tools me-1"></i> Under Active Development
                                        </div>
                                    </div>
                                    <div class="card-body d-flex flex-column p-4">
                                        <h4 class="card-title text-white fw-bold">@featuredProject.Title</h4>
                                        <p class="card-text text-muted small flex-grow-1">@featuredProject.Subtitle</p>

                                        <div class="mt-auto pt-3">
                                            <div class="d-flex flex-wrap gap-1 mb-3">
                                                @if (featuredProject.Technologies != null)
                                                {
                                                    foreach (var tag in featuredProject.Technologies.Split(','))
                                                    {
                                                        <span class="badge bg-dark border border-secondary text-neon-cyan font-monospace small px-2 py-1">@tag.Trim()</span>
                                                    }
                                                }
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-outline-warning btn-sm flex-grow-1 border-warning rounded-pill text-warning font-monospace trigger-under-dev-btn">
                                                    <i class="fas fa-terminal me-1"></i> Inspect System
                                                </button>
                                                @if (!string.IsNullOrEmpty(featuredProject.GitHubLink))
                                                {
                                                    <a href="@featuredProject.GitHubLink" target="_blank" class="btn btn-outline-info btn-sm rounded-circle" title="View Source"><i class="fab fa-github"></i></a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- State B: Witty Under Development Notice (Reveals on Click) -->
                                <div class="under-dev-hidden-view text-center p-4">
                                    <div class="mb-3">
                                        <i class="fas fa-eye-slash text-warning" style="font-size: 2.8rem; filter: drop-shadow(0 0 15px rgba(245, 158, 11, 0.7));"></i>
                                    </div>
                                    <h4 class="text-white fw-bold font-monospace mb-2">Didn't You Read Above? 😉</h4>
                                    <div class="p-3 rounded mb-3 font-monospace small text-warning" style="background: rgba(245, 158, 11, 0.1); border: 1px dashed rgba(245, 158, 11, 0.5); max-width: 90%;">
                                        "Perhaps you didn't notice the tag above — this project is currently UNDER DEVELOPMENT!"
                                    </div>
                                    <p class="text-muted small mb-4 px-2 leading-relaxed">
                                        Saad is actively building and architecting this system. Live access and production deployment will be unlocked soon.
                                    </p>
                                    <button type="button" class="btn btn-outline-warning btn-sm font-monospace rounded-pill px-4 py-2 restore-under-dev-btn">
                                        <i class="fas fa-undo me-2"></i> Show Project Card Again
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="position-relative overflow-hidden" style="height: 230px;">
                                    <img src="@featuredProject.ThumbnailPath" alt="@featuredProject.Title" class="project-thumb-img" />
                                    <div class="position-absolute top-0 end-0 m-3">
                                        @if (featuredProject.Category != null)
                                        {
                                            <span class="badge bg-dark bg-opacity-80 border border-secondary text-neon-cyan font-monospace">@featuredProject.Category.Name</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column p-4">
                                    <h4 class="card-title text-white fw-bold">@featuredProject.Title</h4>
                                    <p class="card-text text-muted small flex-grow-1">@featuredProject.Subtitle</p>

                                    <div class="mt-auto pt-3">
                                        <div class="d-flex flex-wrap gap-1 mb-3">
                                            @if (featuredProject.Technologies != null)
                                            {
                                                foreach (var tag in featuredProject.Technologies.Split(','))
                                                {
                                                    <span class="badge bg-dark border border-secondary text-neon-cyan font-monospace small px-2 py-1">@tag.Trim()</span>
                                                }
                                            }
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Portfolio" asp-action="Details" asp-route-id="@featuredProject.Id" class="btn btn-outline-light btn-sm flex-grow-1 border-secondary rounded-pill hover-bg-light hover-text-dark font-monospace"><i class="fas fa-terminal me-1"></i> Inspect System</a>
                                            @if (!string.IsNullOrEmpty(featuredProject.GitHubLink))
                                            {
                                                <a href="@featuredProject.GitHubLink" target="_blank" class="btn btn-outline-info btn-sm rounded-circle" title="View Source"><i class="fab fa-github"></i></a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (latestProjects != null)
                {
                    foreach (var project in latestProjects)
                    {
                        var isUnderDev = project.Description?.Contains("UNDER DEVELOPMENT", StringComparison.OrdinalIgnoreCase) == true ||
                                         project.Title?.Contains("CyberSentinel", StringComparison.OrdinalIgnoreCase) == true ||
                                         project.Title?.Contains("NeuralMesh", StringComparison.OrdinalIgnoreCase) == true;
                        <div class="col-md-6" data-aos="fade-up" data-aos-delay="200">
                            <div class="card project-terminal-card h-100 cyber-hud-card @(isUnderDev ? "under-dev-card" : "")">
                                <div class="project-window-bar">
                                    <span class="p-dot red"></span>
                                    <span class="p-dot yellow"></span>
                                    <span class="p-dot green"></span>
                                    <span class="project-window-title">~/projects/@(project.Title.ToLower().Replace(" ", "-").Replace("(", "").Replace(")", ""))</span>
                                    @if (isUnderDev)
                                    {
                                        <span class="project-window-badge" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; border: 1px solid #f59e0b;"><i class="fas fa-tools me-1"></i> UNDER DEV</span>
                                    }
                                    else
                                    {
                                        <span class="project-window-badge">PRODUCTION</span>
                                    }
                                </div>

                                @if (isUnderDev)
                                {
                                    <!-- State A: Sleek Normal View -->
                                    <div class="under-dev-normal-view d-flex flex-column flex-grow-1">
                                        <div class="position-relative overflow-hidden" style="height: 230px;">
                                            <img src="@project.ThumbnailPath" alt="@project.Title" class="project-thumb-img" />
                                            <div class="position-absolute top-0 end-0 m-3">
                                                @if (project.Category != null)
                                                {
                                                    <span class="badge bg-dark bg-opacity-80 border border-secondary text-neon-cyan font-monospace">@project.Category.Name</span>
                                                }
                                            </div>
                                            <div class="position-absolute bottom-0 start-0 end-0 p-2 text-center font-monospace small" style="background: rgba(10, 8, 20, 0.85); backdrop-filter: blur(8px); border-top: 1px solid rgba(245, 158, 11, 0.4); color: #f59e0b; font-weight: 600;">
                                                <i class="fas fa-tools me-1"></i> Under Active Development
                                            </div>
                                        </div>
                                        <div class="card-body d-flex flex-column p-4">
                                            <h4 class="card-title text-white fw-bold">@project.Title</h4>
                                            <p class="card-text text-muted small flex-grow-1">@project.Subtitle</p>

                                            <div class="mt-auto pt-3">
                                                <div class="d-flex flex-wrap gap-1 mb-3">
                                                    @if (project.Technologies != null)
                                                    {
                                                        foreach (var tag in project.Technologies.Split(','))
                                                        {
                                                            <span class="badge bg-dark border border-secondary text-neon-cyan font-monospace small px-2 py-1">@tag.Trim()</span>
                                                        }
                                                    }
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-warning btn-sm flex-grow-1 border-warning rounded-pill text-warning font-monospace trigger-under-dev-btn">
                                                        <i class="fas fa-terminal me-1"></i> Inspect System
                                                    </button>
                                                    @if (!string.IsNullOrEmpty(project.GitHubLink))
                                                    {
                                                        <a href="@project.GitHubLink" target="_blank" class="btn btn-outline-info btn-sm rounded-circle" title="View Source"><i class="fab fa-github"></i></a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- State B: Witty Under Development Notice (Reveals on Click) -->
                                    <div class="under-dev-hidden-view text-center p-4">
                                        <div class="mb-3">
                                            <i class="fas fa-eye-slash text-warning" style="font-size: 2.8rem; filter: drop-shadow(0 0 15px rgba(245, 158, 11, 0.7));"></i>
                                        </div>
                                        <h4 class="text-white fw-bold font-monospace mb-2">Didn't You Read Above? 😉</h4>
                                        <div class="p-3 rounded mb-3 font-monospace small text-warning" style="background: rgba(245, 158, 11, 0.1); border: 1px dashed rgba(245, 158, 11, 0.5); max-width: 90%;">
                                            "Perhaps you didn't notice the tag above — this project is currently UNDER DEVELOPMENT!"
                                        </div>
                                        <p class="text-muted small mb-4 px-2 leading-relaxed">
                                            Saad is actively building and architecting this system. Live access and production deployment will be unlocked soon.
                                        </p>
                                        <button type="button" class="btn btn-outline-warning btn-sm font-monospace rounded-pill px-4 py-2 restore-under-dev-btn">
                                            <i class="fas fa-undo me-2"></i> Show Project Card Again
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="position-relative overflow-hidden" style="height: 230px;">
                                        <img src="@project.ThumbnailPath" alt="@project.Title" class="project-thumb-img" />
                                        <div class="position-absolute top-0 end-0 m-3">
                                            @if (project.Category != null)
                                            {
                                                <span class="badge bg-dark bg-opacity-80 border border-secondary text-neon-cyan font-monospace">@project.Category.Name</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="card-body d-flex flex-column p-4">
                                        <h4 class="card-title text-white fw-bold">@project.Title</h4>
                                        <p class="card-text text-muted small flex-grow-1">@project.Subtitle</p>

                                        <div class="mt-auto pt-3">
                                            <div class="d-flex flex-wrap gap-1 mb-3">
                                                @if (project.Technologies != null)
                                                {
                                                    foreach (var tag in project.Technologies.Split(','))
                                                    {
                                                        <span class="badge bg-dark border border-secondary text-neon-cyan font-monospace small px-2 py-1">@tag.Trim()</span>
                                                    }
                                                }
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a asp-controller="Portfolio" asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-light btn-sm flex-grow-1 border-secondary rounded-pill hover-bg-light hover-text-dark font-monospace"><i class="fas fa-terminal me-1"></i> Inspect System</a>
                                                @if (!string.IsNullOrEmpty(project.GitHubLink))
                                                {
                                                    <a href="@project.GitHubLink" target="_blank" class="btn btn-outline-info btn-sm rounded-circle" title="View Source"><i class="fab fa-github"></i></a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
}

