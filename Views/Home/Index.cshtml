@using FuturisticPortfolio.Models.Entities
@{
    ViewData["Title"] = "Home";
    var settings = ViewBag.Settings as Settings;
    var skills = ViewBag.Skills as List<Skill>;
    var statistics = ViewBag.Statistics as List<Statistic>;
    var featuredProject = ViewBag.FeaturedProject as Project;
    var latestProjects = ViewBag.LatestProjects as List<Project>;
}

<!-- HERO SECTION -->
<section class="d-flex align-items-center position-relative overflow-hidden" style="min-height: 90vh; padding-top: 80px;">
    <div class="container py-5 z-2">
        <div class="row align-items-center">
            <div class="col-lg-7 text-center text-lg-start" data-aos="fade-right">
                <span class="badge bg-secondary mb-3 text-uppercase tracking-wider px-3 py-2 font-monospace">WELCOME TO MY PORTFOLIO</span>
                <h1 class="display-3 fw-bold text-white mb-2 text-lg-nowrap">
                    Hi, I am <span class="text-neon-purple">Hafiz Muhammad Saad</span>
                </h1>
                <h2 class="h1 fw-semibold mb-4 text-neon-cyan">
                    <span id="typed-subtitle"></span>
                </h2>
                <p class="lead text-muted mb-4 max-w-lg">
                    Crafting high-performance ASP.NET Core applications, clean relational databases, and modern interactive user interfaces.
                </p>
                <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                    <a href="./files/Muhammad_Saad_CV.pdf" download="Muhammad_Saad_CV.pdf" target="_blank" class="btn btn-neon text-white"><i class="fas fa-file-download me-2"></i> Download CV</a>
                    <a asp-controller="Portfolio" asp-action="Index" class="btn btn-neon btn-neon-cyan text-white"><i class="fas fa-layer-group me-2"></i> View Projects</a>
                    <a href="#contact-section" class="btn btn-outline-light border-secondary px-4 rounded-pill hover-text-white"><i class="fas fa-paper-plane me-2"></i> Contact Me</a>
                </div>

                <!-- Diagnostic Badge (Can be toggled in Preferences) -->
                <div class="system-diagnostic-badge mt-4 p-2 rounded border border-secondary bg-dark font-monospace text-muted d-inline-block text-start" id="system-diagnostic" style="font-size: 0.75rem; border-color: rgba(255, 255, 255, 0.05) !important; background: rgba(17, 12, 28, 0.4) !important;">
                    <i class="fas fa-microchip text-neon-cyan me-1"></i> [SYSTEM STATUS: Online | ASP.NET Core 10 &amp; SQL Server Active]
                </div>
            </div>
            <div class="col-lg-5 mt-5 mt-lg-0 text-center" data-aos="zoom-in" data-aos-delay="200">
                <div class="position-relative d-inline-block">
                    <div class="position-absolute top-50 start-50 translate-middle rounded-circle border border-info border-3 profile-ring-inner" style="width: 330px; height: 330px; opacity: 0.15; box-shadow: 0 0 30px var(--cyan-glow); animation: spin 10s linear infinite;"></div>
                    <div class="position-absolute top-50 start-50 translate-middle rounded-circle border border-primary border-2 profile-ring-outer" style="width: 350px; height: 350px; opacity: 0.25; box-shadow: 0 0 35px var(--primary); animation: spin 15s linear infinite reverse;"></div>
                    
                    <img src="@(settings?.AboutPicturePath ?? "/images/profile.png")" alt="Hafiz Muhammad Saad Profile" class="rounded-circle img-fluid border border-secondary shadow-lg relative z-2 profile-img-responsive" style="width: 280px; height: 280px; object-fit: cover; box-shadow: 0 0 40px rgba(168,85,247,0.3);" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- QUICK STATS STRIP -->
@if (statistics != null && statistics.Any())
{
    <section class="py-4 border-y border-secondary border-opacity-20 bg-dark bg-opacity-30">
        <div class="container">
            <div class="row g-3 text-center justify-content-center">
                @foreach (var stat in statistics)
                {
                    <div class="col-6 col-md-3">
                        <div class="p-3">
                            <h3 class="text-neon-purple fw-bold display-6 mb-0">@stat.Value</h3>
                            <span class="text-muted small">@stat.Title</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ABOUT TEASER SECTION -->
<section class="py-5">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="badge bg-dark border border-secondary text-neon-purple font-monospace mb-2">ABOUT THE DEVELOPER</span>
                <h2 class="display-5 text-white fw-bold mb-3">Software Engineering &amp; Business Computing</h2>
                <p class="text-muted leading-relaxed mb-4">
                    Pursuing <strong>BSBC</strong> at Sohail University and <strong>Advanced Diploma in Software Engineering (ADSE)</strong> at Aptech Learning. Passionate about clean code architecture, relational databases, C#, ASP.NET Core MVC, and modern web application development.
                </p>
                
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge bg-dark border border-info font-monospace p-2" style="color: #00D9FF !important; border-color: rgba(0, 217, 255, 0.5) !important; box-shadow: 0 0 10px rgba(0, 217, 255, 0.2);"><i class="fas fa-graduation-cap me-1"></i> Sohail University (BSBC) — CURRENT DEGREE</span>
                    <span class="badge bg-dark border border-secondary font-monospace p-2" style="color: #A855F7 !important; border-color: rgba(168, 85, 247, 0.4) !important; box-shadow: 0 0 10px rgba(168, 85, 247, 0.2);"><i class="fas fa-university me-1"></i> Aptech Learning (ADSE) — PROFESSIONAL DIPLOMA</span>
                </div>

                <a asp-controller="Home" asp-action="About" class="btn btn-neon text-white"><i class="fas fa-user-circle me-2"></i> Read Full Story</a>
            </div>

            <div class="col-lg-6 mt-4 mt-lg-0" data-aos="fade-left">
                <div class="glass-panel p-4 p-md-5 border-0">
                    <h4 class="text-white fw-bold mb-3"><i class="fas fa-layer-group text-neon-cyan me-2"></i> Core Specializations</h4>
                    <ul class="list-unstyled text-muted small d-flex flex-column gap-3 mb-0">
                        <li class="d-flex align-items-center gap-3">
                            <i class="fas fa-check-circle text-neon-purple fs-5"></i>
                            <div>
                                <strong class="text-white d-block">ASP.NET Core MVC Architecture</strong>
                                Clean Controllers, ViewModels, Dependency Injection, and Razor layouts.
                            </div>
                        </li>
                        <li class="d-flex align-items-center gap-3">
                            <i class="fas fa-check-circle text-neon-cyan fs-5"></i>
                            <div>
                                <strong class="text-white d-block">SQL Server Database Normalization</strong>
                                Entity Framework Core migrations, LINQ optimization, and relational schemas.
                            </div>
                        </li>
                        <li class="d-flex align-items-center gap-3">
                            <i class="fas fa-check-circle text-neon-blue fs-5"></i>
                            <div>
                                <strong class="text-white d-block">Modern Responsive Web Systems</strong>
                                Clean UI design system, glassmorphism, and dual Light/Dark mode themes.
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURED & LATEST PROJECTS SECTION -->
@if (featuredProject != null || (latestProjects != null && latestProjects.Any()))
{
    <section class="py-5 bg-dark bg-opacity-40">
        <div class="container py-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end mb-4" data-aos="fade-up">
                <div>
                    <span class="badge bg-dark border border-secondary text-neon-cyan font-monospace mb-2">PROJECT SHOWCASE</span>
                    <h2 class="display-5 text-white fw-bold mb-0">Selected Projects</h2>
                </div>
                <a asp-controller="Portfolio" asp-action="Index" class="btn btn-outline-light border-secondary rounded-pill hover-text-white mt-3 mt-md-0"><i class="fas fa-th-large me-2"></i> Explore All Projects</a>
            </div>
            
            <div class="row g-4 justify-content-center">
                @if (featuredProject != null)
                {
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="card glass-panel h-100 border-0 overflow-hidden skill-card border-info border-opacity-30">
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                <img src="@featuredProject.ThumbnailPath" alt="Featured project thumbnail" class="card-img-top w-100 h-100" style="object-fit: cover; transition: transform 0.5s;" />
                                <div class="position-absolute top-0 end-0 m-3 d-flex gap-1">
                                    <span class="badge bg-primary text-white">FEATURED</span>
                                    @if (featuredProject.Category != null)
                                    {
                                        <span class="badge bg-dark border border-secondary">@featuredProject.Category.Name</span>
                                    }
                                </div>
                            </div>
                            <div class="card-body d-flex flex-column p-4">
                                <h4 class="card-title text-white fw-semibold">@featuredProject.Title</h4>
                                <p class="card-text text-muted small">@featuredProject.Subtitle</p>
                                <div class="mt-auto pt-3">
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @if (featuredProject.Technologies != null)
                                        {
                                            foreach (var tag in featuredProject.Technologies.Split(','))
                                            {
                                                <span class="badge bg-secondary bg-opacity-20 text-neon-cyan border border-info border-opacity-30 small">@tag.Trim()</span>
                                            }
                                        }
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="/Portfolio/Details/@featuredProject.Id" class="btn btn-outline-light btn-sm flex-grow-1 border-secondary rounded-pill hover-bg-light hover-text-dark">View Details</a>
                                        @if (!string.IsNullOrEmpty(featuredProject.GitHubLink))
                                        {
                                            <a href="@featuredProject.GitHubLink" target="_blank" class="btn btn-outline-info btn-sm rounded-circle" title="GitHub Code"><i class="fab fa-github"></i></a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (latestProjects != null)
                {
                    foreach (var project in latestProjects)
                    {
                        <div class="col-md-6" data-aos="fade-up" data-aos-delay="200">
                            <div class="card glass-panel h-100 border-0 overflow-hidden skill-card">
                                <div class="position-relative overflow-hidden" style="height: 220px;">
                                    <img src="@project.ThumbnailPath" alt="Project thumbnail" class="card-img-top w-100 h-100" style="object-fit: cover; transition: transform 0.5s;" />
                                    <div class="position-absolute top-0 end-0 m-3">
                                        @if (project.Category != null)
                                        {
                                            <span class="badge bg-dark border border-secondary">@project.Category.Name</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column p-4">
                                    <h4 class="card-title text-white fw-semibold">@project.Title</h4>
                                    <p class="card-text text-muted small">@project.Subtitle</p>
                                    <div class="mt-auto pt-3">
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @if (project.Technologies != null)
                                            {
                                                foreach (var tag in project.Technologies.Split(','))
                                                {
                                                    <span class="badge bg-secondary bg-opacity-20 text-neon-cyan border border-info border-opacity-30 small">@tag.Trim()</span>
                                                }
                                            }
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/Portfolio/Details/@project.Id" class="btn btn-outline-light btn-sm flex-grow-1 border-secondary rounded-pill hover-bg-light hover-text-dark">View Details</a>
                                            @if (!string.IsNullOrEmpty(project.GitHubLink))
                                            {
                                                <a href="@project.GitHubLink" target="_blank" class="btn btn-outline-info btn-sm rounded-circle" title="GitHub Code"><i class="fab fa-github"></i></a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
}

<!-- TECH STACK ICONS -->
<section class="py-5">
    <div class="container py-4 text-center">
        <h4 class="h6 text-muted text-uppercase tracking-wider font-monospace mb-4">Core Technology Stack</h4>
        <div class="d-flex flex-wrap justify-content-center gap-4" data-aos="zoom-in">
            <div class="tech-icon-box" title="C#"><i class="fas fa-code text-neon-purple"></i></div>
            <div class="tech-icon-box" title="ASP.NET Core"><i class="fab fa-microsoft text-neon-cyan"></i></div>
            <div class="tech-icon-box" title="SQL Server"><i class="fas fa-database text-neon-blue"></i></div>
            <div class="tech-icon-box" title="JavaScript"><i class="fab fa-js text-warning"></i></div>
            <div class="tech-icon-box" title="Git"><i class="fab fa-git-alt text-danger"></i></div>
            <div class="tech-icon-box" title="HTML5"><i class="fab fa-html5 text-neon-cyan"></i></div>
            <div class="tech-icon-box" title="CSS3"><i class="fab fa-css3-alt text-neon-purple"></i></div>
            <div class="tech-icon-box" title="Bootstrap 5"><i class="fab fa-bootstrap text-primary"></i></div>
        </div>
    </div>
</section>

<!-- CONTACT SECTION -->
<section id="contact-section" class="py-5 bg-dark bg-opacity-40">
    <div class="container py-4">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="badge bg-dark border border-secondary text-neon-purple font-monospace mb-2">COMMUNICATIONS</span>
            <h2 class="display-5 text-white fw-bold">Get In Touch</h2>
            <p class="text-muted">Send inquiries, project proposals, or professional opportunities.</p>
        </div>
        
        <div class="row g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="glass-panel p-4 p-md-5 h-100">
                    <h3 class="text-white fw-bold mb-4"><i class="fas fa-paper-plane text-neon-purple me-2"></i> Contact Form</h3>
                    
                    <form id="contact-form" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label text-muted small">YOUR NAME</label>
                            <input type="text" name="Name" class="form-control bg-dark border-secondary text-white rounded-3 py-2" required placeholder="e.g. Recruiter / Client Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small">YOUR EMAIL</label>
                            <input type="email" name="Email" class="form-control bg-dark border-secondary text-white rounded-3 py-2" required placeholder="e.g. client@domain.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small">SUBJECT</label>
                            <input type="text" name="Subject" class="form-control bg-dark border-secondary text-white rounded-3 py-2" required placeholder="e.g. Software Engineering Opportunity" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-muted small">MESSAGE</label>
                            <textarea name="Body" rows="4" class="form-control bg-dark border-secondary text-white rounded-3 py-2" required placeholder="Write your message here..."></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-paper-plane me-2"></i> Send Message</button>
                    </form>
                    <div id="contact-submit-status" class="mt-3" style="display: none;"></div>
                </div>
            </div>
            
            <div class="col-lg-6" data-aos="fade-left">
                <div class="glass-panel p-4 p-md-5 h-100 d-flex flex-column">
                    <h3 class="text-white fw-bold mb-4"><i class="fas fa-map-marked-alt text-neon-cyan me-2"></i> Location &amp; Contact</h3>
                    <p class="text-muted small">Based in Karachi, Pakistan. Available for remote and hybrid opportunities.</p>
                    <div class="flex-grow-1 rounded-3 overflow-hidden border border-secondary shadow mb-4" style="min-height: 220px;">
                        @if (settings != null && !string.IsNullOrEmpty(settings.OpenStreetMapEmbedUrl))
                        {
                            <iframe src="@settings.OpenStreetMapEmbedUrl" width="100%" height="100%" style="border:0; filter: invert(90%) hue-rotate(240deg) brightness(85%);" allowfullscreen="" loading="lazy"></iframe>
                        }
                    </div>
                    <div class="d-flex flex-column gap-2 text-muted small">
                        <span><i class="fas fa-envelope text-neon-purple me-2"></i> @settings?.ContactEmail</span>
                        <span><i class="fas fa-phone-alt text-neon-cyan me-2"></i> @settings?.ContactPhone</span>
                        <span><i class="fas fa-map-pin text-neon-blue me-2"></i> @settings?.ContactAddress</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/typed.js@2.0.16/dist/typed.umd.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            new Typed('#typed-subtitle', {
                strings: ['Software Developer', 'ASP.NET Core MVC & C# Engineer', 'BSBC @@ Sohail University', 'ADSE @@ Aptech Learning'],
                typeSpeed: 60,
                backSpeed: 30,
                loop: true
            });
        });
    </script>
}
