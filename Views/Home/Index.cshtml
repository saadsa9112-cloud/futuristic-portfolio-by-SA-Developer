                            <i class="fas fa-envelope-open-text me-2"></i> Load Scope into Contact Form
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- LIVE GITHUB TELEMETRY STRIP -->
<section class="py-4 border-top border-secondary border-opacity-20 bg-dark bg-opacity-20">
    <div class="container py-2">
        <div class="glass-panel p-3 p-md-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 font-monospace" data-aos="fade-up">
            <div class="d-flex align-items-center gap-3">
                <div class="fs-1 text-white"><i class="fab fa-github"></i></div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="text-white fw-bold mb-0">saadsa9112-cloud</h6>
                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-40">ACTIVE CONTRIBUTOR</span>
                    </div>
                    <small class="text-muted">C# · ASP.NET Core · MERN Stack · SQL Server · Graphic Design</small>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="text-center px-3 py-1 rounded bg-dark border border-secondary">
                    <span class="d-block text-neon-cyan fw-bold">5+</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">REPOSITORIES</span>
                </div>
                <div class="text-center px-3 py-1 rounded bg-dark border border-secondary">
                    <span class="d-block text-neon-purple fw-bold">100%</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">CI/CD VERIFIED</span>
                </div>
                <a href="https://github.com/saadsa9112-cloud" target="_blank" class="btn btn-outline-cyan rounded-pill px-3 py-1.5 small font-monospace">
                    View GitHub Profile <i class="fas fa-external-link-alt ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- CONTACT SECTION -->
<section id="contact-section" class="py-5 bg-dark bg-opacity-40">
    <div class="container py-3">
        <div class="text-center mb-4" data-aos="fade-up">
            <span class="badge bg-dark border border-secondary text-neon-purple font-monospace mb-2">COMMUNICATIONS</span>
            <h2 class="display-5 text-white fw-bold">Get In Touch</h2>
            <p class="text-muted mb-0">Send inquiries, project proposals, or professional opportunities.</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="glass-panel p-4 p-md-5 h-100">
                    <h3 class="text-white fw-bold mb-4"><i class="fas fa-paper-plane text-neon-purple me-2"></i> Contact Form</h3>
                    
                    <form id="contact-form" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label text-muted small">YOUR NAME</label>
                            <input type="text" name="Name" class="form-control bg-dark border-secondary text-white rounded-3 py-2" required placeholder="e.g. Recruiter / Client Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small">YOUR EMAIL</label>
                            <input type="email" name="Email" class="form-control bg-dark border-secondary text-white rounded-3 py-2" required placeholder="e.g. client@domain.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small">SUBJECT</label>
                            <input type="text" name="Subject" class="form-control bg-dark border-secondary text-white rounded-3 py-2" required placeholder="e.g. Software Engineering Opportunity" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-muted small">MESSAGE</label>
                            <textarea name="Body" rows="4" class="form-control bg-dark border-secondary text-white rounded-3 py-2" required placeholder="Write your message here..."></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-neon w-100 text-white"><i class="fas fa-paper-plane me-2"></i> Send Message</button>
                    </form>
                    <div id="contact-submit-status" class="mt-3" style="display: none;"></div>
                </div>
            </div>
            
            <div class="col-lg-6" data-aos="fade-left">
                <div class="glass-panel p-4 p-md-5 h-100 d-flex flex-column">
                    <h3 class="text-white fw-bold mb-4"><i class="fas fa-map-marked-alt text-neon-cyan me-2"></i> Location &amp; Contact</h3>
                    <p class="text-muted small">Based in Karachi, Pakistan. Available for remote and hybrid opportunities.</p>
                    <div class="flex-grow-1 rounded-3 overflow-hidden border border-secondary shadow mb-4" style="min-height: 220px;">
                        @{
                            var pakistanMapUrl = "https://www.openstreetmap.org/export/embed.html?bbox=66.8500%2C24.7500%2C67.2500%2C25.0500&layer=mapnik&marker=24.8607%2C67.0011";
                            var activeMapUrl = (!string.IsNullOrEmpty(settings?.OpenStreetMapEmbedUrl) && !settings.OpenStreetMapEmbedUrl.Contains("-74.009"))
                                ? settings.OpenStreetMapEmbedUrl
                                : pakistanMapUrl;
                        }
                        <iframe src="@activeMapUrl" width="100%" height="100%" style="border:0; filter: invert(90%) hue-rotate(240deg) brightness(85%);" allowfullscreen="" loading="lazy"></iframe>
                    </div>
                    <div class="d-flex flex-column gap-2 text-muted small">
                        <span><i class="fas fa-envelope text-neon-purple me-2"></i> @settings?.ContactEmail</span>
                        <span><i class="fas fa-phone-alt text-neon-cyan me-2"></i> @settings?.ContactPhone</span>
                        <span><i class="fas fa-map-pin text-neon-blue me-2"></i> @settings?.ContactAddress</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/typed.js@2.0.16/dist/typed.umd.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            new Typed('#typed-subtitle', {
                strings: [
                    'Full-Stack Software Engineer',
                    'ASP.NET Core 10 & C# Specialist',
                    'MERN Stack Web Developer',
                    'Graphic Designer & UI/UX Specialist',
                    'SEO & Performance Tuning Expert',
                    'BSBC @@ Sohail University'
                ],
                typeSpeed: 50,
                backSpeed: 25,
                loop: true
            });
        });
    </script>
}
