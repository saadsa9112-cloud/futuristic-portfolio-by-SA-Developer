                <!-- Holographic Hazard Icon Podium -->
                <div class="roast-icon-podium mb-3">
                    <div class="roast-glow-pulse"></div>
                    <div class="roast-avatar-bubble">
                        <span class="roast-emoji-main">🕶️</span>
                        <span class="roast-emoji-burst">💥</span>
                    </div>
                </div>

                <h3 class="text-white fw-black font-monospace mb-2 roast-headline" id="roast-modal-title">
                    WHO TAUGHT YOU HOW TO USE A COMPUTER?!
                </h3>

                <div class="mb-3 d-inline-block">
                    <span class="roast-badge-pill">
                        <i class="fas fa-exclamation-triangle text-danger me-1"></i> [FATAL EXCEPTION: ZERO DEVELOPER CREDIBILITY FOUND]
                    </span>
                </div>

                <!-- Live Hazard Diagnostics Ribbon -->
                <div class="roast-telemetry-strip mb-3">
                    <div class="roast-tele-col">
                        <span class="tele-lbl">LUX OUTPUT</span>
                        <span class="tele-val text-danger">9,999,999 cd/m²</span>
                    </div>
                    <div class="roast-tele-col">
                        <span class="tele-lbl">DEV STATUS</span>
                        <span class="tele-val text-warning">DISCREDITED</span>
                    </div>
                    <div class="roast-tele-col d-none d-sm-flex">
                        <span class="tele-lbl">TARGET EDITOR</span>
                        <span class="tele-val text-info">MS Word (.docx)</span>
                    </div>
                </div>

                <!-- Savage Roast Grid -->
                <div class="roast-cards-container text-start mb-3 d-flex flex-column gap-2">
                    <div class="roast-mini-card">
                        <div class="roast-mini-icon text-danger"><i class="fas fa-radiation"></i></div>
                        <div class="roast-mini-text">
                            <strong class="text-danger-light">Retina Flashbang Protocol:</strong>
                            <span class="text-slate-light">Did you just scorch your retinas with 10,000,000 lumens of blinding white light? Are you debugging code or signaling an alien rescue ship?!</span>
                        </div>
                    </div>
                    <div class="roast-mini-card">
                        <div class="roast-mini-icon text-warning"><i class="fas fa-skull"></i></div>
                        <div class="roast-mini-text">
                            <strong class="text-warning-light">Pure Developer Heresy:</strong>
                            <span class="text-slate-light">Real engineers haven't seen daylight since 2018. Light Mode makes you look like you write HTML in Word and debug with alert boxes.</span>
                        </div>
                    </div>
                    <div class="roast-mini-card">
                        <div class="roast-mini-icon text-danger"><i class="fas fa-ban"></i></div>
                        <div class="roast-mini-text">
                            <strong class="text-danger-light">Emergency Restraining Order:</strong>
                            <span class="text-slate-light">Your IDE just crashed in second-hand embarrassment, and the SQL database server refused to execute your queries out of sheer disgust.</span>
                        </div>
                    </div>
                </div>

                <!-- Savage Action Buttons -->
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn roast-btn-revert py-2.5 px-3 rounded-pill fw-bold font-monospace d-flex align-items-center justify-content-center gap-2" id="roast-modal-revert">
                        <i class="fas fa-moon fs-5"></i> 🌙 I APOLOGIZE TO MY EYES — GO BACK TO DARK MODE
                    </button>
                    <button type="button" class="btn roast-btn-ignore py-2 px-3 rounded-pill font-monospace small" id="roast-modal-ignore">
                        🤡 No, I Enjoy Self-Harm &amp; Want To Go Completely Blind (Stay In Flashbang Mode)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Architecture Quick-Scan Slide-out Drawer -->
    <div id="arch-scan-overlay" class="arch-scan-backdrop" style="display: none;"></div>
    <div id="arch-scan-drawer" class="arch-scan-panel" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="arch-drawer-title">
        <div class="arch-drawer-header d-flex justify-content-between align-items-center p-3 border-bottom border-secondary bg-dark">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary border border-secondary text-neon-cyan font-monospace px-2 py-1">
                    <i class="fas fa-microchip me-1"></i> ARCH-SCAN v2.0
                </span>
                <h5 class="text-white mb-0 font-monospace" id="arch-drawer-title">System Architecture Topology</h5>
            </div>
            <button type="button" class="btn btn-sm btn-link text-white text-decoration-none fs-4 p-0 px-2" id="arch-drawer-close" aria-label="Close Drawer">&times;</button>
        </div>
        <div class="arch-drawer-body p-4" id="arch-drawer-content">
            <!-- Dynamically populated by site.js -->
        </div>
    </div>
    }

    @if (flags.EnableMatrixRain)
    {
    <!-- Matrix Rain Canvas Overlay -->
    <div id="matrix-rain-overlay" class="matrix-canvas-wrapper" style="display: none;">
        <canvas id="matrix-canvas"></canvas>
        <div class="matrix-exit-hint font-monospace">
            <span>[MATRIX MODE ACTIVE // PRESS ESC OR CLICK SCREEN TO EXIT]</span>
        </div>
    </div>
    }

    <!-- Script Assets -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/hms-telemetry.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
