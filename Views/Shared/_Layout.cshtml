@using FuturisticPortfolio.Models.Entities
@inject FuturisticPortfolio.Services.IFeatureFlagService FeatureFlagService
@{
    var settings = ViewBag.Settings as Settings;
    var socialLinks = ViewBag.SocialLinks as List<SocialLink>;
    var siteName = settings?.SiteName ?? "HMS Developer";
    var flags = FeatureFlagService.GetFlags();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - {siteName}" : $"{siteName} | Software Engineer & Systems Architect")</title>
    <link rel="icon" type="image/x-icon" href="@(settings?.FaviconPath ?? "/favicon.ico")" />
    
    <!-- Meta SEO & Anti-Caching for Mobile Browsers -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="title" content="@(ViewData["MetaTitle"] ?? settings?.MetaTitle ?? "HMS Developer | Software Engineer & Systems Architect")" />
        <meta name="description" content="@(ViewData["MetaDescription"] ?? settings?.MetaDescription ?? "HMS Developer (Hafiz Muhammad Saad) — Software Developer & Systems Architect specializing in ASP.NET Core MVC, MERN Stack, SQL Server, Graphic Designing, and SEO.")" />
    <meta name="author" content="Hafiz Muhammad Saad (HMS Developer)" />
    <meta name="keywords" content="Muhammad Saad, Full Stack Developer, ASP.NET Core MVC, MERN Stack, C#, SQL Server, Systems Architect, Karachi Pakistan, Cyber Security, UI UX Designer" />
    <link rel="canonical" href="https://hmsdeveloper.com/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hmsdeveloper.com/" />
    <meta property="og:title" content="@(ViewData["MetaTitle"] ?? settings?.MetaTitle ?? "HMS Developer | Software Engineer & Systems Architect")" />
    <meta property="og:description" content="Portfolio of Hafiz Muhammad Saad — Full-Stack Software Engineer specializing in ASP.NET Core 10, MERN Stack, Zero-Trust Architecture & Enterprise Systems." />
    <meta property="og:image" content="https://hmsdeveloper.com/favicon.svg" />
    <meta property="og:site_name" content="HMS Developer Portfolio" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://hmsdeveloper.com/" />
    <meta name="twitter:title" content="@(ViewData["MetaTitle"] ?? settings?.MetaTitle ?? "HMS Developer | Software Engineer & Systems Architect")" />
    <meta name="twitter:description" content="Portfolio of Hafiz Muhammad Saad — Full-Stack Software Engineer specializing in ASP.NET Core 10, MERN Stack, Zero-Trust Architecture & Enterprise Systems." />
    <meta name="twitter:image" content="https://hmsdeveloper.com/favicon.svg" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Person",
      "name": "Hafiz Muhammad Saad",
      "alternateName": "HMS Developer",
      "url": "https://hmsdeveloper.com",
      "email": "saad.sa9112@gmail.com",
      "telephone": "+923055188896",
      "jobTitle": "Full-Stack Software Engineer & Systems Architect",
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "Karachi",
        "addressCountry": "Pakistan"
      },
      "sameAs": [
        "https://github.com/saadsa9112-cloud"
      ],
      "knowsAbout": ["C#", "ASP.NET Core", "React", "Node.js", "MongoDB", "SQL Server", "Zero-Trust Architecture", "SEO Optimization"]
    }
    </script>

    <!-- Style Assets -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FuturisticPortfolio.styles.css" asp-append-version="true" />
    
    <!-- CDNs for Premium Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />

    <!-- Immediate Scroll Lock to prevent background index page scroll during welcome/loader -->
    <script>
        (function() {
            var path = window.location.pathname.toLowerCase();
            var isHome = path === "/" || path === "" || path.endsWith("/index.html") || path.endsWith("/futuristic-portfolio-by-sa-developer/") || path.endsWith("/dist/");
            var hasSeen = sessionStorage.getItem("saad_welcome_shown") === "true";
            if (isHome || !hasSeen) {
                document.documentElement.classList.add("lock-scroll");
            }
        })();
    </script>
</head>
<body>
    <!-- Scroll Progress Bar -->
    <div id="scroll-progress"></div>

    <!-- Interactive Ambient Glow -->
    <div class="ambient-glow"></div>

    <!-- Custom Neon Cursor -->
    <div class="custom-cursor d-none d-lg-block"></div>
    <div class="custom-cursor-dot d-none d-lg-block"></div>

    <!-- Developer Terminal Boot Loader -->
    <div id="loader-screen" role="status" aria-label="Loading portfolio">
        <div class="dev-terminal">
            <div class="dev-terminal-bar">
                <div class="dev-terminal-dots">
                    <span></span><span></span><span></span>
                </div>
                <div class="dev-terminal-title" id="dev-terminal-title">saad@portfolio ~ bash</div>
            </div>
            <div class="dev-terminal-body" id="dev-log-body">
                <!-- Lines injected by JS -->
            </div>
        </div>
    </div>

    <!-- Dedicated First-Visit Animated Welcome Screen -->
    <div id="welcome-screen" class="welcome-overlay" style="display: none;" role="dialog" aria-label="Welcome to Hafiz Muhammad Saad Portfolio">
        <div class="welcome-backdrop-glow"></div>
        <div class="welcome-container">
            <!-- Step 1: Main Welcome View -->
            <div id="welcome-view-main" class="welcome-view-panel">
                <!-- Animated Cyber Ring Emblem -->
                <div class="welcome-emblem">
                    <div class="welcome-outer-ring"></div>
                    <div class="welcome-inner-ring"></div>
                    <div class="welcome-icon-box">
                        <i class="fas fa-terminal"></i>
                    </div>
                </div>

                <!-- Status Chip -->
                <div class="welcome-chip">
                    <span class="chip-pulse"></span>
                    <span>SYSTEM ONLINE · ACCESS GRANTED</span>
                </div>

                <!-- Animated Header -->
                <div class="welcome-meta-sub">// HELLO WORLD</div>
                <h1 class="welcome-hero-title">
                    <span class="welcome-lead-text">WELCOME TO</span>
                    <span class="welcome-name-glow">HMS DEVELOPER</span>
                    <span class="welcome-sub-text">HAFIZ MUHAMMAD SAAD</span>
                </h1>

                <!-- Catchy Tagline -->
                <p class="welcome-hero-tagline">
                    "Architecting Resilient Enterprise Solutions, .NET &amp; MERN Stack Systems, UI/UX Design &amp; SEO-Engineered Platforms"
                </p>

                <!-- Specs Grid -->
                <div class="welcome-specs-grid">
                    <div class="spec-pill">
                        <i class="fas fa-bolt text-neon-cyan me-1"></i> ASP.NET Core &amp; MERN Stack
                    </div>
                    <div class="spec-pill">
                        <i class="fas fa-palette text-neon-purple me-1"></i> Graphic Designing &amp; UI/UX
                    </div>
                    <div class="spec-pill">
                        <i class="fas fa-chart-line text-neon-blue me-1"></i> SEO &amp; Enterprise Performance
                    </div>
                </div>

                <!-- Primary Enter Button -->
                <div class="pt-2">
                    <button id="welcome-skip-btn" class="welcome-enter-btn" type="button">
                        <span>Enter Portfolio</span> <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>

            <!-- Step 2: Prestigious Client Handshake View (Triggered on Button Click) -->
            <div id="welcome-view-handshake" class="welcome-handshake-card" style="display: none;">
                <div class="handshake-badge">
                    <span>🤝</span>
                    <span>EXECUTIVE CLIENT HANDSHAKE VERIFIED</span>
                </div>

                <div class="handshake-icon-hero">
                    🚀
                </div>

                <h2 class="handshake-title">
                    You're in <span class="handshake-highlight">Exceptional Hands</span> 🌟
                </h2>

                <p class="handshake-body">
                    Welcome! You have officially connected with a passionate, high-impact <strong>Full-Stack Software Engineer &amp; Systems Architect</strong>. 
                    From high-throughput <strong>C# / .NET 10</strong> backends to modern, responsive enterprise applications—your vision is in the hands of an expert dedicated to <strong>flawless production excellence</strong>. 💎
                </p>

                <div class="handshake-quote-box">
                    ⚡ "Where architectural precision meets world-class scalability and clean code craft."
                </div>

                <!-- 3-Second Countdown Meter -->
                <div class="handshake-progress-outer">
                    <div class="handshake-progress-bar" id="handshake-progress-bar"></div>
                </div>
                <div class="handshake-status-row">
                    <span class="text-neon-cyan"><i class="fas fa-circle-notch fa-spin me-1"></i></span>
                    <span>Launching Executive Environment in <strong id="handshake-timer-num" class="text-white">3</strong>s...</span>
                </div>
            </div>
        </div>
    </div>


    <!-- Particles Background -->
    <div id="particles-js"></div>

    <!-- Header Navigation -->
    <!-- Header Navigation -->
    <header class="fixed-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-futuristic py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="cyber-brand-logo-frame">
                        <i class="fas fa-terminal text-neon-cyan"></i>
                    </div>
                    <div class="d-flex flex-column text-start">
                        <span class="cyber-brand-text fw-bold">
                            <span class="text-neon-cyan">&lt;</span><span class="text-white">HMS DEVELOPER</span><span class="text-neon-purple"> /&gt;</span>
                        </span>
                        <span class="cyber-brand-sub font-monospace">H. M. SAAD // SOFTWARE ENGINEER</span>
                    </div>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbarNav" aria-controls="mainNavbarNav" id="mainNavbarToggler"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end" id="mainNavbarNav">
                    <ul class="navbar-nav gap-3 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Portfolio" asp-action="Index">Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                        @if (flags.EnableAudioSfx)
                        {
                            <li class="nav-item d-flex align-items-center ms-lg-2">
                                <button type="button" class="btn btn-sm btn-neon-cyan font-monospace px-2.5 py-1 d-flex align-items-center gap-1 recruiter-mode-trigger shadow-sm" id="nav-recruiter-btn" title="Open 30-Second Recruiter Summary Dossier">
                                    <i class="fas fa-bolt text-warning"></i>
                                    <span class="fw-bold" style="font-size: 0.76rem;">Recruiter Mode</span>
                                </button>
                            </li>
                            <li class="nav-item d-flex align-items-center ms-lg-1">
                                <button type="button" class="btn btn-link text-white p-2 border-0" id="sfx-toggle-btn" style="text-decoration: none; box-shadow: none;" title="Toggle Cyber Audio FX">
                                    <i class="fas fa-volume-mute text-secondary" id="sfx-icon"></i>
                                    <span class="d-none d-xl-inline font-monospace small ms-1 text-muted" id="sfx-label" style="font-size: 0.72rem;">SFX: OFF</span>
                                </button>
                            </li>
                        }
                        <li class="nav-item d-flex align-items-center ms-lg-1 me-lg-1">
                            <button type="button" class="btn btn-link text-white p-2 border-0" id="theme-toggle-btn" style="text-decoration: none; box-shadow: none;" title="Toggle Theme">
                                <i class="fas fa-sun" id="theme-icon"></i>
                            </button>
                        </li>
                        <li class="nav-item d-flex align-items-center me-1">
                            <button type="button" class="btn btn-link text-white p-2 border-0" data-bs-toggle="modal" data-bs-target="#preferencesModal" title="Site Preferences & Settings">
                                <i class="fas fa-cog text-neon-cyan"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Cyber Security & Architectural Telemetry Ribbon -->
        <div class="cyber-telemetry-ribbon font-monospace" id="cyber-telemetry-ribbon">
            <div class="container d-flex align-items-center justify-content-between py-1 px-3">
                <div class="d-flex align-items-center gap-2 gap-md-3 overflow-hidden text-nowrap">
                    <span class="cyber-status-pulse">
                        <span class="pulse-dot-green"></span>
                        <strong class="text-neon-green">SEC-OPS: ARMED</strong>
                    </span>
                    <span class="text-secondary opacity-50 d-none d-sm-inline">|</span>
                    <span class="cyber-metric-item d-none d-sm-inline">
                        <i class="fas fa-shield-alt text-neon-cyan me-1"></i> ZERO-TRUST: <span class="text-white">ENFORCED</span>
                    </span>
                    <span class="text-secondary opacity-50 d-none d-md-inline">|</span>
                    <span class="cyber-metric-item d-none d-md-inline">
                        <i class="fas fa-microchip text-neon-purple me-1"></i> eBPF KERNEL: <span class="text-white">MONITORING</span>
                    </span>
                    <span class="text-secondary opacity-50 d-none d-lg-inline">|</span>
                    <span class="cyber-metric-item d-none d-lg-inline">
                        <i class="fas fa-lock text-info me-1"></i> TLS 1.3 / AES-256-GCM
                    </span>
                    <span class="text-secondary opacity-50 d-none d-xl-inline">|</span>
                    <span class="cyber-metric-item d-none d-xl-inline">
                        <i class="fas fa-robot text-warning me-1"></i> CLAUDE MYTHOS GUARD
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-2">
                    <span class="cyber-metric-item d-none d-md-inline">
                        <i class="fas fa-clock text-warning me-1"></i> KHI: <span id="live-khi-clock" class="text-white">--:--:--</span>
                    </span>
                    <span class="text-secondary opacity-50 d-none d-lg-inline">|</span>
                    <span class="cyber-metric-item d-none d-lg-inline">
                        <span class="pulse-dot-green me-1"></span><span class="text-neon-green">AVAILABLE FOR HIRE</span>
                    </span>
                    <span class="text-secondary opacity-50 d-none d-md-inline">|</span>
                    <span class="cyber-ping-badge" id="live-ping-val">
                        <i class="fas fa-bolt text-success me-1"></i> 14ms (PK-KHI)
                    </span>
                    <button type="button" class="btn btn-outline-cyan cyber-cli-btn py-0 px-2 font-monospace" id="open-cyber-terminal-btn" title="Launch Interactive Cyber Security Console (Ctrl+K)">
                        <i class="fas fa-terminal me-1"></i> CLI
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Grid -->
    <main role="main" class="site-main page-transition">
        @RenderBody()
    </main>

    <!-- Saad's AI Assistant Widget -->
    <div class="ai-chat-widget glass-panel" id="ai-chat-widget" role="dialog" aria-labelledby="ai-chat-title" aria-modal="true">
        <!-- Header -->
        <div class="ai-chat-header d-flex justify-content-between align-items-center px-3 py-2.5">
            <div class="d-flex align-items-center gap-2.5">
                <div class="ai-avatar-badge rounded-circle d-flex align-items-center justify-content-center">
                    <i class="fas fa-robot text-neon-cyan fs-6"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white fw-bold font-monospace" id="ai-chat-title" style="font-size: 0.92rem;">Saad's AI Assistant</h6>
                    <div class="d-flex align-items-center gap-1.5" style="font-size: 0.72rem;">
                        <span class="pulse-dot bg-success rounded-circle" style="width: 6px; height: 6px; box-shadow: 0 0 8px #10b981;"></span>
                        <span class="text-success fw-medium">AI Assistant • Online</span>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm text-muted p-1 hover-text-white transition border-0 bg-transparent" id="ai-chat-reset" title="Reset Chat" aria-label="Reset Conversation">
                    <i class="fas fa-redo-alt fs-6"></i>
                </button>
                <button type="button" class="btn btn-sm text-muted p-1 hover-text-white transition border-0 bg-transparent" id="ai-chat-close" title="Close" aria-label="Close Assistant">
                    <i class="fas fa-times fs-6"></i>
                </button>
            </div>
        </div>

        <!-- Messages Container -->
        <div class="ai-chat-messages" id="ai-messages-container" aria-live="polite">
            <!-- Populated dynamically via JS -->
        </div>

        <!-- Quick Chips Bar -->
        <div class="ai-quick-bar px-3 py-2 border-top border-secondary border-opacity-20">
            <div class="quick-chips-container d-flex gap-1.5 overflow-x-auto pb-1" id="quick-action-chips">
                <button type="button" class="quick-chip chip-whatsapp" data-query="WhatsApp Contact"><i class="fab fa-whatsapp me-1 text-success"></i> WhatsApp</button>
                <button type="button" class="quick-chip chip-cv" data-query="Download CV"><i class="fas fa-file-download me-1 text-danger"></i> Download CV</button>
                <button type="button" class="quick-chip" data-query="Projects"><i class="fas fa-folder-open me-1 text-neon-cyan"></i> Projects</button>
                <button type="button" class="quick-chip" data-query="Tech Stack"><i class="fas fa-code me-1 text-neon-purple"></i> Tech Stack</button>
                <button type="button" class="quick-chip" data-query="Education"><i class="fas fa-graduation-cap me-1 text-info"></i> Education</button>
                <button type="button" class="quick-chip" data-query="Experience"><i class="fas fa-briefcase me-1 text-warning"></i> Experience</button>
                <button type="button" class="quick-chip" data-query="About Saad"><i class="fas fa-user-check me-1 text-primary"></i> About Saad</button>
            </div>
        </div>

        <!-- Input Area -->
        <div class="ai-chat-input p-2.5 d-flex align-items-center gap-2 border-top border-secondary border-opacity-20">
            <textarea class="form-control ai-input-field border-0 shadow-none text-white bg-transparent" placeholder="Ask me about Saad's projects, skills, education..." id="ai-user-message" rows="1" autocomplete="off" aria-label="Ask Saad's AI Assistant"></textarea>
            <button type="button" class="btn btn-gradient-send rounded-circle d-flex align-items-center justify-content-center transition flex-shrink-0" id="ai-send-message" aria-label="Send Message">
                <i class="fas fa-paper-plane fs-6"></i>
            </button>
        </div>
    </div>

    <!-- Floating Chat Trigger Button -->
    <button type="button" class="fab-btn d-flex align-items-center justify-content-center shadow-lg" id="ai-chat-toggle" title="Saad's AI Assistant" aria-label="Ask Saad's AI Assistant">
        <i class="fas fa-robot fs-4 text-white"></i>
    </button>

    <!-- Footer Area -->
    <!-- Footer Section -->
    <footer class="footer-section border-top mt-4 pt-4 pb-3 text-start">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Brand Info Column (4 cols) -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand-box mb-3">
                        <h4 class="text-neon-purple fw-bold mb-2">&lt; HMS Developer /&gt;</h4>
                        <p class="text-muted small leading-relaxed mb-3">
                            Hafiz Muhammad Saad — Software Developer specializing in ASP.NET Core MVC, MERN Stack, SQL Server, Graphic Designing, and SEO-engineered web systems.
                        </p>
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill border border-success border-opacity-30 bg-success bg-opacity-10">
                            <span class="pulse-dot bg-success rounded-circle" style="width: 8px; height: 8px; box-shadow: 0 0 10px #10b981;"></span>
                            <span class="small font-monospace text-success fw-semibold" style="font-size: 0.78rem;">SYSTEM OPERATIONAL | ASP.NET CORE 10</span>
                        </div>
                    </div>
                </div>

                <!-- Navigation Links Column (2 cols) -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="text-white fw-semibold mb-3">Navigation</h5>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 footer-nav-list">
                        <li><a asp-controller="Home" asp-action="Index" class="footer-nav-link"><i class="fas fa-chevron-right footer-nav-arrow"></i> <span>Home</span></a></li>
                        <li><a asp-controller="Home" asp-action="About" class="footer-nav-link"><i class="fas fa-chevron-right footer-nav-arrow"></i> <span>About</span></a></li>
                        <li><a asp-controller="Home" asp-action="About" asp-fragment="skills-section" class="footer-nav-link"><i class="fas fa-chevron-right footer-nav-arrow"></i> <span>Skills</span></a></li>
                        <li><a asp-controller="Portfolio" asp-action="Index" class="footer-nav-link"><i class="fas fa-chevron-right footer-nav-arrow"></i> <span>Projects</span></a></li>
                        <li><a asp-controller="Blog" asp-action="Index" class="footer-nav-link"><i class="fas fa-chevron-right footer-nav-arrow"></i> <span>Tech Logs</span></a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="footer-nav-link"><i class="fas fa-chevron-right footer-nav-arrow"></i> <span>Contact</span></a></li>
                    </ul>
                </div>

                <!-- Education & Credentials Column (3 cols) -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-white fw-semibold mb-3">Education &amp; Diplomas</h5>
                    <div class="d-flex flex-column gap-3">
                        <div class="p-3 rounded-3 glass-panel border border-secondary border-opacity-30">
                            <span class="d-block text-neon-cyan font-monospace fw-semibold mb-1" style="font-size: 0.78rem;"><i class="fas fa-graduation-cap me-1.5"></i> CURRENT DEGREE</span>
                            <div class="text-white fw-semibold fs-6">BSBC</div>
                            <div class="text-muted small">Sohail University (2025–2029)</div>
                        </div>
                        <div class="p-3 rounded-3 glass-panel border border-secondary border-opacity-30">
                            <span class="d-block text-neon-purple font-monospace fw-semibold mb-1" style="font-size: 0.78rem;"><i class="fas fa-certificate me-1.5"></i> PROFESSIONAL DIPLOMA</span>
                            <div class="text-white fw-semibold fs-6">ADSE</div>
                            <div class="text-muted small">Aptech Learning (2024–2027)</div>
                        </div>
                    </div>
                </div>

                <!-- Contact & Social Networks Column (3 cols) -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-white fw-semibold mb-3">Contact &amp; Location</h5>
                    <ul class="list-unstyled text-muted small mb-3 d-flex flex-column gap-2">
