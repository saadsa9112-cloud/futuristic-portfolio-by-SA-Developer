@using FuturisticPortfolio.Models.Entities
@{
    var settings = ViewBag.Settings as Settings;
    var socialLinks = ViewBag.SocialLinks as List<SocialLink>;
    var siteName = settings?.SiteName ?? "Futuristic Portfolio";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName</title>
    
    <!-- Meta SEO & Anti-Caching for Mobile Browsers -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="title" content="@(ViewData["MetaTitle"] ?? settings?.MetaTitle ?? "Hafiz Muhammad Saad | Software Developer Portfolio")" />
    <meta name="description" content="@(ViewData["MetaDescription"] ?? settings?.MetaDescription ?? "Motivated and detail-oriented Software Developer specializing in ASP.NET Core MVC, C#, PHP, SQL Server, MySQL, and modern web development.")" />

    <!-- Style Assets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FuturisticPortfolio.styles.css" asp-append-version="true" />
    
    <!-- CDNs for Premium Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
</head>
<body>
    <!-- Scroll Progress Bar -->
    <div id="scroll-progress"></div>

    <!-- Interactive Ambient Glow -->
    <div class="ambient-glow"></div>

    <!-- Custom Neon Cursor -->
    <div class="custom-cursor d-none d-lg-block"></div>
    <div class="custom-cursor-dot d-none d-lg-block"></div>

    <!-- Loader Screen -->
    <div id="loader-screen">
        <div class="loader-spinner"></div>
        <div class="loader-text">INITIALIZING SYSTEMS...</div>
    </div>

    <!-- Particles Background -->
    <div id="particles-js"></div>

    <!-- Header Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-futuristic fixed-top py-3">
            <div class="container">
                <a class="navbar-brand text-neon-purple fw-bold" asp-controller="Home" asp-action="Index">
                    @if (settings != null && !string.IsNullOrEmpty(settings.LogoPath))
                    {
                        <img src="@settings.LogoPath" alt="Logo" class="d-inline-block align-top me-2" style="max-height:30px;" />
                    }
                    <span>&lt;@settings?.SiteName.Split('|')[0].Trim() /&gt;</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav gap-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Portfolio" asp-action="Index">Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#contact-section">Contact</a>
                        </li>
                        <li class="nav-item d-flex align-items-center ms-lg-2 me-lg-1">
                            <button type="button" class="btn btn-link text-white p-2 border-0" id="theme-toggle-btn" style="text-decoration: none; box-shadow: none;" title="Toggle Theme">
                                <i class="fas fa-sun" id="theme-icon"></i>
                            </button>
                        </li>
                        <li class="nav-item d-flex align-items-center me-1">
                            <button type="button" class="btn btn-link text-white p-2 border-0" data-bs-toggle="modal" data-bs-target="#preferencesModal" title="Site Preferences & Settings">
                                <i class="fas fa-cog text-neon-cyan"></i>
                            </button>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Grid -->
    <main role="main" class="pt-5 mt-4 page-transition">
        @RenderBody()
    </main>

    <!-- Saad's AI Assistant Widget -->
    <div class="ai-chat-widget glass-panel" id="ai-chat-widget" role="dialog" aria-labelledby="ai-chat-title" aria-modal="true">
        <!-- Header -->
        <div class="ai-chat-header d-flex justify-content-between align-items-center px-3 py-2.5">
            <div class="d-flex align-items-center gap-2.5">
                <div class="ai-avatar-badge rounded-circle d-flex align-items-center justify-content-center">
                    <i class="fas fa-robot text-neon-cyan fs-6"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-white fw-bold font-monospace" id="ai-chat-title" style="font-size: 0.92rem;">Saad's AI Assistant</h6>
                    <div class="d-flex align-items-center gap-1.5" style="font-size: 0.72rem;">
                        <span class="pulse-dot bg-success rounded-circle" style="width: 6px; height: 6px; box-shadow: 0 0 8px #10b981;"></span>
                        <span class="text-success fw-medium">AI Assistant • Online</span>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button class="btn btn-sm text-muted p-1 hover-text-white transition border-0 bg-transparent" id="ai-chat-reset" title="Reset Chat" aria-label="Reset Conversation">
                    <i class="fas fa-redo-alt fs-6"></i>
                </button>
                <button class="btn btn-sm text-muted p-1 hover-text-white transition border-0 bg-transparent" id="ai-chat-close" title="Close" aria-label="Close Assistant">
                    <i class="fas fa-times fs-6"></i>
                </button>
            </div>
        </div>

        <!-- Messages Container -->
        <div class="ai-chat-messages" id="ai-messages-container" aria-live="polite">
            <!-- Populated dynamically via JS -->
        </div>

        <!-- Quick Chips Bar -->
        <div class="ai-quick-bar px-3 py-2 border-top border-secondary border-opacity-20">
            <div class="quick-chips-container d-flex gap-1.5 overflow-x-auto pb-1" id="quick-action-chips">
                <button class="quick-chip chip-whatsapp" data-query="WhatsApp Contact"><i class="fab fa-whatsapp me-1 text-success"></i> WhatsApp</button>
                <button class="quick-chip chip-cv" data-query="Download CV"><i class="fas fa-file-download me-1 text-danger"></i> Download CV</button>
                <button class="quick-chip" data-query="Projects"><i class="fas fa-folder-open me-1 text-neon-cyan"></i> Projects</button>
                <button class="quick-chip" data-query="Tech Stack"><i class="fas fa-code me-1 text-neon-purple"></i> Tech Stack</button>
                <button class="quick-chip" data-query="Education"><i class="fas fa-graduation-cap me-1 text-info"></i> Education</button>
                <button class="quick-chip" data-query="Experience"><i class="fas fa-briefcase me-1 text-warning"></i> Experience</button>
                <button class="quick-chip" data-query="About Saad"><i class="fas fa-user-check me-1 text-primary"></i> About Saad</button>
            </div>
        </div>

        <!-- Input Area -->
        <div class="ai-chat-input p-2.5 d-flex align-items-center gap-2 border-top border-secondary border-opacity-20">
            <textarea class="form-control ai-input-field border-0 shadow-none text-white bg-transparent" placeholder="Ask me about Saad's projects, skills, education..." id="ai-user-message" rows="1" autocomplete="off" aria-label="Ask Saad's AI Assistant"></textarea>
            <button class="btn btn-gradient-send rounded-circle d-flex align-items-center justify-content-center transition flex-shrink-0" id="ai-send-message" aria-label="Send Message">
                <i class="fas fa-paper-plane fs-6"></i>
            </button>
        </div>
    </div>

    <!-- Floating Chat Trigger Button -->
    <button class="fab-btn d-flex align-items-center justify-content-center shadow-lg" id="ai-chat-toggle" title="Saad's AI Assistant" aria-label="Ask Saad's AI Assistant">
        <i class="fas fa-robot fs-4 text-white"></i>
    </button>

    <!-- Footer Area -->
    <!-- Footer Section -->
    <footer class="footer-section border-top mt-5 pt-5 pb-4 text-start">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Brand Info Column (4 cols) -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand-box mb-3">
                        <h4 class="text-neon-purple fw-bold mb-2">&lt; Hafiz Muhammad Saad /&gt;</h4>
                        <p class="text-muted small leading-relaxed mb-3">
                            Software Developer specializing in ASP.NET Core MVC, C#, SQL Server, normalized database architectures, and modern web application engineering.
                        </p>
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill border border-success border-opacity-30 bg-success bg-opacity-10">
                            <span class="pulse-dot bg-success rounded-circle" style="width: 8px; height: 8px; box-shadow: 0 0 10px #10b981;"></span>
                            <span class="small font-monospace text-success fw-semibold" style="font-size: 0.78rem;">SYSTEM OPERATIONAL | ASP.NET CORE 10</span>
                        </div>
                    </div>
                </div>

                <!-- Navigation Links Column (2 cols) -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="text-white fw-semibold mb-3">Navigation</h5>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 footer-nav-list">
                        <li><a asp-controller="Home" asp-action="Index" class="footer-nav-link"><i class="fas fa-chevron-right text-neon-purple"></i> <span>Home</span></a></li>
                        <li><a asp-controller="Home" asp-action="About" class="footer-nav-link"><i class="fas fa-chevron-right text-neon-purple"></i> <span>About</span></a></li>
                        <li><a href="/Home/About#skills-section" class="footer-nav-link"><i class="fas fa-chevron-right text-neon-purple"></i> <span>Skills</span></a></li>
                        <li><a asp-controller="Portfolio" asp-action="Index" class="footer-nav-link"><i class="fas fa-chevron-right text-neon-purple"></i> <span>Projects</span></a></li>
                        <li><a asp-controller="Blog" asp-action="Index" class="footer-nav-link"><i class="fas fa-chevron-right text-neon-purple"></i> <span>Tech Logs</span></a></li>
                        <li><a href="/#contact-section" class="footer-nav-link"><i class="fas fa-chevron-right text-neon-purple"></i> <span>Contact</span></a></li>
                    </ul>
                </div>

                <!-- Education & Credentials Column (3 cols) -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-white fw-semibold mb-3">Education &amp; Diplomas</h5>
                    <div class="d-flex flex-column gap-3">
                        <div class="p-3 rounded-3 glass-panel border border-secondary border-opacity-30">
                            <span class="d-block text-neon-cyan font-monospace fw-semibold mb-1" style="font-size: 0.78rem;"><i class="fas fa-graduation-cap me-1.5"></i> CURRENT DEGREE</span>
                            <div class="text-white fw-semibold fs-6">BSBC</div>
                            <div class="text-muted small">Sohail University (2025–2029)</div>
                        </div>
                        <div class="p-3 rounded-3 glass-panel border border-secondary border-opacity-30">
                            <span class="d-block text-neon-purple font-monospace fw-semibold mb-1" style="font-size: 0.78rem;"><i class="fas fa-certificate me-1.5"></i> PROFESSIONAL DIPLOMA</span>
                            <div class="text-white fw-semibold fs-6">ADSE</div>
                            <div class="text-muted small">Aptech Learning (2024–2027)</div>
                        </div>
                    </div>
                </div>

                <!-- Contact & Social Networks Column (3 cols) -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-white fw-semibold mb-3">Contact &amp; Location</h5>
                    <ul class="list-unstyled text-muted small mb-3 d-flex flex-column gap-2">
                        <li class="d-flex align-items-center gap-2"><i class="fas fa-map-marker-alt text-neon-cyan"></i> <span>Karachi, Pakistan</span></li>
                        <li class="d-flex align-items-center gap-2"><i class="fas fa-envelope text-neon-purple"></i> <a href="mailto:saad.sa9112@gmail.com" class="text-muted text-decoration-none hover-text-white">saad.sa9112@gmail.com</a></li>
                        <li class="d-flex align-items-center gap-2"><i class="fas fa-phone text-success"></i> <a href="tel:+923055188896" class="text-muted text-decoration-none hover-text-white">+92 305 5188896</a></li>
                    </ul>
                    <div class="d-flex gap-2">
                        @if (socialLinks != null)
                        {
                            foreach (var link in socialLinks)
                            {
                                <a href="@link.Url" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle text-white transition hover-border-purple footer-social-btn" title="@link.PlatformName"><i class="@link.IconClass"></i></a>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Bottom Copyright & Back To Top -->
            <div class="pt-4 border-top border-secondary border-opacity-20 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <p class="text-muted small mb-0">@(settings?.FooterText ?? "© 2026 Hafiz Muhammad Saad (HMS Developer). All Rights Reserved. Built with ASP.NET Core MVC & SQL Server.")</p>
                <a href="#" class="btn btn-sm btn-outline-light border-secondary text-muted rounded-pill px-3 py-1.5 text-decoration-none hover-text-white transition"><i class="fas fa-arrow-up me-1"></i> Back to Top</a>
            </div>
        </div>
    </footer>

    <!-- Command Palette Overlay -->
    <div class="command-palette-overlay" id="command-palette">
        <div class="command-palette-box glass-panel p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-secondary"><i class="fas fa-terminal me-1"></i> CONTROL CONSOLE</span>
                <span class="small text-muted">Press <kbd class="bg-dark text-neon-cyan px-2">ESC</kbd> to exit</span>
            </div>
            <input type="text" class="form-control bg-dark border-secondary text-white mb-3 py-2" id="command-search" placeholder="Type a command or navigate..." autocomplete="off" />
            <div class="command-list" id="command-results">
                <div class="command-item clickable" data-action="nav" data-url="/"><i class="fas fa-home me-2 text-neon-purple"></i> Go to Homepage <span class="badge bg-dark ms-auto">G + H</span></div>
                <div class="command-item clickable" data-action="nav" data-url="/Portfolio"><i class="fas fa-folder-open me-2 text-neon-cyan"></i> Browse Projects Databank <span class="badge bg-dark ms-auto">G + P</span></div>
                <div class="command-item clickable" data-action="nav" data-url="/Blog"><i class="fas fa-file-alt me-2 text-neon-blue"></i> Read Tech Logs <span class="badge bg-dark ms-auto">G + B</span></div>
                <div class="command-item clickable" data-action="ai"><i class="fas fa-robot me-2 text-warning"></i> Query AI Portfolio Agent <span class="badge bg-dark ms-auto">A + I</span></div>
                <div class="command-item clickable" data-action="contact"><i class="fas fa-satellite-dish me-2 text-success"></i> Establish Comms Link (Contact) <span class="badge bg-dark ms-auto">C + O</span></div>
                <div class="command-item clickable" data-action="sound"><i class="fas fa-volume-up me-2 text-neon-cyan"></i> Synthesize Audio Test <span class="badge bg-dark ms-auto">S + N</span></div>
                <div class="command-item clickable text-danger border-danger" data-action="nav" data-url="/Admin/Dashboard"><i class="fas fa-terminal me-2 text-danger"></i> sudo admin <span class="badge bg-dark ms-auto">S + A</span></div>
            </div>
        </div>
    </div>

    <!-- Cookie Consent Banner -->
    <div class="cookie-banner glass-panel p-3 text-start" id="cookie-banner" style="position: fixed; bottom: 20px; left: 20px; width: calc(100% - 40px); max-width: 400px; z-index: 100000; display: none; background: rgba(17, 12, 28, 0.95) !important; border: 1px solid rgba(168, 85, 247, 0.4) !important; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="fas fa-cookie-bite text-warning fs-4"></i>
            <h6 class="mb-0 text-white fw-bold">Telemetry Access Consent</h6>
        </div>
        <p class="small text-muted mb-3" style="font-size: 0.8rem; line-height: 1.4;">We use cookies to analyze user interest packets (like photo views, project details, or play clicks) for portfolio calibration.</p>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-neon text-white px-3" id="cookie-accept-btn">Accept Consent</button>
            <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="cookie-decline-btn">Reject</button>
        </div>
    </div>

    <!-- Site Preferences & Settings Modal -->
    <div class="modal fade" id="preferencesModal" tabindex="-1" aria-labelledby="preferencesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-panel text-white border-secondary" style="background: rgba(17, 12, 28, 0.96) !important;">
                <div class="modal-header border-secondary border-opacity-35">
                    <h5 class="modal-title font-monospace fw-bold text-neon-cyan" id="preferencesModalLabel">
                        <i class="fas fa-cog text-neon-purple me-2"></i> Site Preferences &amp; Settings
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex align-items-center justify-content-between p-3 rounded glass-panel">
                            <div>
                                <h6 class="mb-0 text-white fw-semibold"><i class="fas fa-volume-up text-neon-purple me-2"></i> Click Sound Effects</h6>
                                <small class="text-muted d-block">Synthesize audio beeps on interactive clicks</small>
                            </div>
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input bg-dark" type="checkbox" id="pref-sound-toggle" />
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between p-3 rounded glass-panel">
                            <div>
                                <h6 class="mb-0 text-white fw-semibold"><i class="fas fa-shield-alt text-danger me-2"></i> Security Breach Overlay Alert</h6>
                                <small class="text-muted d-block">Allow security glitch overlay on rapid trigger</small>
                            </div>
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input bg-dark" type="checkbox" id="pref-glitch-toggle" />
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between p-3 rounded glass-panel">
                            <div>
                                <h6 class="mb-0 text-white fw-semibold"><i class="fas fa-star text-warning me-2"></i> Particle Canvas Background</h6>
                                <small class="text-muted d-block">Animate background particles</small>
                            </div>
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input bg-dark" type="checkbox" id="pref-particles-toggle" checked />
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between p-3 rounded glass-panel">
                            <div>
                                <h6 class="mb-0 text-white fw-semibold"><i class="fas fa-microchip text-neon-cyan me-2"></i> System Diagnostics Badge</h6>
                                <small class="text-muted d-block">Display system status badge on Hero banner</small>
                            </div>
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input bg-dark" type="checkbox" id="pref-diagnostic-toggle" checked />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-35">
                    <button type="button" class="btn btn-neon text-white w-100" id="save-preferences-btn" data-bs-dismiss="modal">
                        <i class="fas fa-save me-2"></i> Apply &amp; Save Preferences
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Danger Security Alert Overlay -->
    <div class="danger-security-overlay" id="danger-security-overlay">
        <i class="fas fa-skull-crossbones text-danger mb-4" style="font-size: 5rem; animation: pulse 1s infinite alternate;"></i>
        <div class="glitch-title">SECURITY BREACH DETECTED</div>
        <p class="warning-desc">If you press this again, your tracking will start and you cannot hide yourself from us.</p>
        <button type="button" class="btn btn-outline-danger px-4 py-2 mt-4 font-monospace" id="danger-close-btn" style="border-radius: 0; text-transform: uppercase;">Abort Handshake</button>
    </div>

    <!-- Script Assets -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/hms-telemetry.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
