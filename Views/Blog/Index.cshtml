@model List<FuturisticPortfolio.Models.Entities.Blog>
@using FuturisticPortfolio.Models.Entities
@{
    ViewData["Title"] = "Tech Logs";
    var categories = ViewBag.Categories as List<Category>;
    var currentCategory = ViewBag.CurrentCategory as int?;
    var search = ViewBag.Search as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="container py-5">
    <!-- Header Page Description -->
    <div class="text-center mb-5" data-aos="fade-up">
        <h1 class="display-4 text-white fw-bold"><span class="text-neon-cyan">//</span> Tech Logs & Insights</h1>
        <p class="text-muted">Articles regarding full-stack engineering, performance tuning, and architectural blueprints.</p>
    </div>

    <!-- Search & Filter Controls Panel -->
    <div class="glass-panel p-4 mb-5" data-aos="fade-up">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" class="form-control bg-dark border-secondary text-white" placeholder="Search articles, tags..." value="@search" />
                </div>
            </div>
            
            <div class="col-md-4">
                <select name="categoryId" class="form-select bg-dark border-secondary text-muted" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            if (currentCategory == cat.Id)
                            {
                                <option value="@cat.Id" selected="selected">@cat.Name</option>
                            }
                            else
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    }
                </select>
            </div>
            
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-neon btn-neon-cyan w-100 text-white"><i class="fas fa-filter me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="fas fa-undo"></i></a>
            </div>
        </form>
    </div>

    <!-- Blogs Grid -->
    <div class="row g-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center py-5" data-aos="fade-up">
                <div class="fs-1 text-neon-cyan mb-3"><i class="fas fa-book-open"></i></div>
                <h3 class="text-white">Query Returned Zero Logs</h3>
                <p class="text-muted">No articles found matching the specified parameters.</p>
            </div>
        }
        else
        {
            foreach (var post in Model)
            {
                <div class="col-md-6 col-lg-4" data-aos="fade-up">
                    <div class="card glass-panel h-100 border-0 overflow-hidden skill-card">
                        @if (!string.IsNullOrEmpty(post.ImagePath))
                        {
                            <div class="position-relative overflow-hidden" style="height: 200px;">
                                <img src="@post.ImagePath" alt="Article image" class="card-img-top w-100 h-100" style="object-fit: cover;" />
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-dark border border-secondary text-neon-purple align-self-start mb-2">@post.Category?.Name</span>
                            <h3 class="h4 card-title text-white fw-bold">@post.Title</h3>
                            <p class="small text-muted mb-3"><i class="fas fa-calendar-alt me-1"></i> @post.CreatedDate.ToString("MMMM dd, yyyy") | <i class="fas fa-eye me-1"></i> @post.ViewCount Reads</p>
                            
                            <div class="mt-auto">
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @if (post.Tags != null)
                                    {
                                        foreach (var tag in post.Tags.Split(','))
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-muted small">#@tag.Trim()</span>
                                        }
                                    }
                                </div>
                                <a href="/Blog/Details?slug=@post.Slug" class="btn btn-neon btn-neon-cyan btn-sm w-100 text-white">Read Article <i class="fas fa-arrow-right ms-1"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Pagination Controls -->
    @if (totalPages > 1)
    {
        <nav class="mt-5" data-aos="fade-up">
            <ul class="pagination justify-content-center gap-2">
                @for (int i = 1; i <= totalPages; i++)
                {
                    var activeClass = i == currentPage ? "active" : "";
                    var activeStyle = i == currentPage ? "background-color: var(--cyan-glow); border-color: var(--cyan-glow);" : "background: var(--bg-card); border: 1px solid rgba(255,255,255,0.08);";
                    <li class="page-item @activeClass">
                        <a href="/Blog?search=@search&categoryId=@currentCategory&page=@i" class="page-link rounded-circle text-center text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; @activeStyle">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
