@model List<FuturisticPortfolio.Models.Entities.Project>
@using FuturisticPortfolio.Models.Entities
@{
    ViewData["Title"] = "Projects Databank";
    var categories = ViewBag.Categories as List<Category>;
    var currentCategory = ViewBag.CurrentCategory as int?;
    var search = ViewBag.Search as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="container py-4">
    <!-- Header Page Description -->
    <div class="text-center mb-4" data-aos="fade-up">
        <h1 class="display-5 text-white fw-bold"><span class="text-neon-purple">//</span> Projects Databank</h1>
        <p class="text-muted mb-0">Explore production system deployments, web architectures, and autonomous AI modules.</p>
    </div>

    <!-- Filter Controls Panel: 4 Smart Architectural Groups -->
    <div class="glass-panel p-3 mb-4 text-center" data-aos="fade-up" id="portfolio-filter-panel">
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-2" id="portfolio-filter-group">
            <button type="button" class="btn btn-sm btn-neon text-white px-4 py-2 rounded-pill project-filter-btn active" data-filter="all">
                All Systems <span class="badge bg-dark ms-1 text-neon-cyan border border-secondary">5</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary text-white px-4 py-2 rounded-pill project-filter-btn" data-filter="dotnet">
                Enterprise .NET &amp; Web <span class="badge bg-dark ms-1 text-neon-purple border border-secondary">3</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary text-white px-4 py-2 rounded-pill project-filter-btn" data-filter="cyber">
                Cybersecurity &amp; Kernel <span class="badge bg-dark ms-1 text-neon-blue border border-secondary">1</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary text-white px-4 py-2 rounded-pill project-filter-btn" data-filter="ai">
                AI &amp; Distributed Systems <span class="badge bg-dark ms-1 text-warning border border-secondary">1</span>
            </button>
        </div>
    </div>

    <!-- Projects Grid -->
    <div class="row g-4" id="portfolio-grid">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center py-4" data-aos="fade-up">
                <div class="fs-1 text-neon-purple mb-3"><i class="fas fa-folder-open"></i></div>
                <h3 class="text-white">Query Returned Zero Nodes</h3>
                <p class="text-muted">No projects match the specified filter queries.</p>
            </div>
        }
        else
        {
            foreach (var project in Model)
            {
                var title = project.Title ?? "";
                var isUnderDev = project.Description?.Contains("UNDER DEVELOPMENT", StringComparison.OrdinalIgnoreCase) == true ||
                                 title.Contains("CyberSentinel", StringComparison.OrdinalIgnoreCase) ||
                                 title.Contains("NeuralMesh", StringComparison.OrdinalIgnoreCase);

                var categoryGroup = "dotnet";
                if (title.Contains("CyberSentinel", StringComparison.OrdinalIgnoreCase))
                {
                    categoryGroup = "cyber";
                }
                else if (title.Contains("NeuralMesh", StringComparison.OrdinalIgnoreCase))
                {
                    categoryGroup = "ai";
                }
                <div class="col-md-6 col-lg-4 project-card-item" data-category-group="@categoryGroup" data-aos="fade-up">
                    <div class="card project-terminal-card h-100 border-0 cyber-hud-card @(isUnderDev ? "under-dev-card" : "")">
                        <div class="project-window-bar">
                            <span class="p-dot red"></span>
                            <span class="p-dot yellow"></span>
                            <span class="p-dot green"></span>
                            <span class="project-window-title">~/projects/@(project.Title.ToLower().Replace(" ", "-").Replace("(", "").Replace(")", ""))</span>
                            @if (isUnderDev)
                            {
                                <span class="project-window-badge" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; border: 1px solid #f59e0b;"><i class="fas fa-tools me-1"></i> UNDER DEV</span>
                            }
                            else
                            {
                                <span class="project-window-badge">PROD</span>
                            }
                        </div>

                        @if (isUnderDev)
                        {
                            <!-- State A: Sleek Normal View -->
                            <div class="under-dev-normal-view d-flex flex-column flex-grow-1">
                                <div class="position-relative overflow-hidden" style="height: 220px;">
                                    <img src="@project.ThumbnailPath" alt="@project.Title" class="project-thumb-img w-100 h-100" />
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="badge bg-dark bg-opacity-80 border border-secondary text-neon-cyan font-monospace">@project.Category?.Name</span>
                                    </div>
                                    <div class="position-absolute bottom-0 start-0 end-0 p-2 text-center font-monospace small" style="background: rgba(10, 8, 20, 0.85); backdrop-filter: blur(8px); border-top: 1px solid rgba(245, 158, 11, 0.4); color: #f59e0b; font-weight: 600;">
                                        <i class="fas fa-tools me-1"></i> Under Active Development
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column p-4">
                                    <h3 class="h5 card-title text-white fw-bold mb-2">@project.Title</h3>
                                    <p class="card-text text-muted small flex-grow-1">@project.Subtitle</p>

                                    <div class="d-flex flex-wrap gap-1 mb-4">
                                        @if (project.Technologies != null)
                                        {
                                            foreach (var tag in project.Technologies.Split(','))
                                            {
                                                <span class="badge bg-dark border border-secondary text-neon-cyan font-monospace small px-2 py-1">@tag.Trim()</span>
                                            }
                                        }
                                    </div>
                                    
                                    <div class="d-flex gap-2 mt-auto">
                                        <button type="button" class="btn btn-outline-warning btn-sm flex-grow-1 border-warning rounded-pill text-warning font-monospace trigger-under-dev-btn">
                                            <i class="fas fa-terminal me-1"></i> Inspect System
                                        </button>
                                        @if (!string.IsNullOrEmpty(project.GitHubLink))
                                        {
                                            <a href="@project.GitHubLink" target="_blank" class="btn btn-outline-info btn-sm rounded-circle" title="View Source"><i class="fab fa-github"></i></a>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- State B: Witty Under Development Notice (Reveals on Click) -->
                            <div class="under-dev-hidden-view text-center p-4 d-flex flex-column align-items-center justify-content-center flex-grow-1" style="display: none; min-height: 380px;">
                                <div class="mb-3">
                                    <i class="fas fa-eye-slash text-warning" style="font-size: 2.8rem; filter: drop-shadow(0 0 15px rgba(245, 158, 11, 0.7));"></i>
                                </div>
                                <h4 class="text-white fw-bold font-monospace mb-2">Didn't You Read Above? 😉</h4>
                                <div class="p-3 rounded mb-3 font-monospace small text-warning" style="background: rgba(245, 158, 11, 0.1); border: 1px dashed rgba(245, 158, 11, 0.5); max-width: 90%;">
                                    "Perhaps you didn't notice the tag above — this project is currently UNDER DEVELOPMENT!"
                                </div>
                                <p class="text-muted small mb-4 px-2 leading-relaxed">
                                    Saad is actively building and architecting this system. Live access and production deployment will be unlocked soon.
                                </p>
                                <button type="button" class="btn btn-outline-warning btn-sm font-monospace rounded-pill px-4 py-2 restore-under-dev-btn">
                                    <i class="fas fa-undo me-2"></i> Show Project Card Again
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                <img src="@project.ThumbnailPath" alt="@project.Title" class="project-thumb-img w-100 h-100" />
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span class="badge bg-dark bg-opacity-80 border border-secondary text-neon-cyan font-monospace">@project.Category?.Name</span>
                                </div>
                            </div>
                            <div class="card-body d-flex flex-column p-4">
                                <h3 class="h5 card-title text-white fw-bold mb-2">@project.Title</h3>
                                <p class="card-text text-muted small flex-grow-1">@project.Subtitle</p>

                                <div class="d-flex flex-wrap gap-1 mb-4">
                                    @if (project.Technologies != null)
                                    {
                                        foreach (var tag in project.Technologies.Split(','))
                                        {
                                            <span class="badge bg-dark border border-secondary text-neon-cyan font-monospace small px-2 py-1">@tag.Trim()</span>
                                        }
                                    }
                                </div>
                                
                                <div class="d-flex gap-2 mt-auto">
                                    <a asp-controller="Portfolio" asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-light btn-sm flex-grow-1 border-secondary rounded-pill text-white hover-bg-light hover-text-dark font-monospace"><i class="fas fa-terminal me-1"></i> Inspect System</a>
                                    @if (!string.IsNullOrEmpty(project.GitHubLink))
                                    {
                                        <a href="@project.GitHubLink" target="_blank" class="btn btn-outline-info btn-sm rounded-circle" title="View Source"><i class="fab fa-github"></i></a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- Pagination Controls -->
    @if (totalPages > 1)
    {
        <nav class="mt-5" data-aos="fade-up">
            <ul class="pagination justify-content-center gap-2">
                @for (int i = 1; i <= totalPages; i++)
                {
                    var activeClass = i == currentPage ? "active" : "";
                    var activeStyle = i == currentPage ? "background-color: var(--primary); border-color: var(--primary);" : "background: var(--bg-card); border: 1px solid rgba(255,255,255,0.08);";
                    <li class="page-item @activeClass">
                        <a href="/Portfolio?search=@search&categoryId=@currentCategory&page=@i" class="page-link rounded-circle text-center text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; @activeStyle">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
